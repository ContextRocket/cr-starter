# Optional overrides for the Astro static starter (PUBLIC_* are inlined at build).

# PUBLIC_SITE_NAME=
# PUBLIC_SITE_URL=
# PUBLIC_CONTACT_EMAIL=
# PUBLIC_DEFAULT_LOCALE=en

# Chat / ContextRocket embed
# PUBLIC_CR_CHAT_MODE=demo
# Optional published IIFE URL; defaults to the checked-in local widget.
# PUBLIC_CONTEXTROCKET_CHAT_WIDGET_URL=https://contextrocket.cdn.contextrocket.com/embeds/chat/v0.1.5/widget.js
# Optional published version-pinned URL; defaults to the checked-in local bridge.
# PUBLIC_CONTEXTROCKET_CONTACT_FORM_SCRIPT_URL=https://contextrocket.cdn.contextrocket.com/embeds/contact-form/v0.1.1/contact-form.browser.js
# Optional published consent/integrations bundle; defaults to the checked-in local file.
# PUBLIC_CONTEXTROCKET_SITE_BEHAVIORS_URL=https://contextrocket.cdn.contextrocket.com/embeds/site-behaviors/v0.1.1/site-behaviors.browser.js
# PUBLIC_CR_CHAT_FULLSCREEN=true
# PUBLIC_CR_CHAT_FULLSCREEN_ON_OPEN=false
# PUBLIC_CR_CHAT_FULLSCREEN_ON_LOAD=false
# PUBLIC_CR_CHAT_POSITION=bottom-right
# PUBLIC_CR_AGENT_URL=https://api.contextrocket.com
# The handle only selects an organization; it does not provision or enable it.
# Confirm the org and its public A2A policy before setting chat mode to live.
# PUBLIC_CONTEXTROCKET_HANDLE=contextrocket
# PUBLIC_CONTEXTROCKET_API_KEY=
# PUBLIC_CR_CONTACT_FORM_MODE=demo

# PUBLIC_COOKIE_CONSENT=off
# PUBLIC_POWERED_BY_BADGE=true
