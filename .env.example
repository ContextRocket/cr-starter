# ContextRocket Starter -- environment template
# Copy to .env and adjust for your deployment.
#
# This file is loaded by the Makefile (-include .env) and docker-compose.yml.
# Next.js does NOT read this file -- frontend NEXT_PUBLIC_* vars belong in
# frontend/.env.example (copy to frontend/.env.local).
#
# ============================================================
# PORTS -- single source of truth
# All ports are isolated from the sibling context-rocket project
# (which uses 3000 / 8000 / 5442 / 5443 / 1025 / 8025).
# grep confirms no port literal appears twice outside this block.
# ============================================================
FRONTEND_PORT=3100
BACKEND_PORT=8100
DB_PORT=5452
DB_TEST_PORT=5453
MAILHOG_SMTP_PORT=1026
MAILHOG_UI_PORT=8026

# ============================================================
# Database (consumed by docker compose and backend config)
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:${DB_PORT}/app_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:${DB_TEST_PORT}/app_test_db

# ============================================================
# Secrets -- CHANGE these in production
# ============================================================
ACCESS_SECRET_KEY=dev-access-secret-CHANGE-IN-PRODUCTION-min-32-chars
RESET_PASSWORD_SECRET_KEY=dev-reset-secret-CHANGE-IN-PRODUCTION-min-32-chars
VERIFICATION_SECRET_KEY=dev-verify-secret-CHANGE-IN-PRODUCTION-min-32-chars

# ============================================================
# Guest token lifetime (seconds). Default 72h = 259200.
# ============================================================
GUEST_TOKEN_LIFETIME_SECONDS=259200

# ============================================================
# Email (MailHog for local dev; override for production SMTP)
# ============================================================
MAIL_SERVER=localhost
MAIL_PORT=${MAILHOG_SMTP_PORT}
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME=ContextRocket Starter

# ============================================================
# CORS origins (comma-separated or JSON array)
# Never use ["*"] with credentials: wildcard CORS with cookies or
# Authorization headers is rejected by all major browsers.
# ============================================================
CORS_ORIGINS=["http://localhost:${FRONTEND_PORT}"]
