          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "review_state": {
          "default": "approved",
          "enum": [
            "approved",
            "draft",
            "rejected"
          ],
