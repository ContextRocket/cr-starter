          "default": "unknown",
          "enum": [
            "owned",
            "licensed",
            "unknown"
          ],
          "title": "Rights Posture",
          "type": "string"
        },
        "role": {
          "default": "other",
          "enum": [
            "logo",
            "wordmark",
            "hero",
            "media",
            "avatar",
            "social",
            "icon",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "surface_suitability": {
          "items": {
            "enum": [
              "light",
              "dark",
              "any"
            ],
            "type": "string"
          },
          "title": "Surface Suitability",
          "type": "array"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "asset_id",
        "local_path",
        "alt_text"
      ],
      "title": "AssetRef",
      "type": "object"
    },
