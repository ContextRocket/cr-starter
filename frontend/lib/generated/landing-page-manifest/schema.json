    "AnalyticsIntent": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "event_names": {
          "items": {
            "enum": [
              "view",
              "cta",
              "form_start",
              "form_submit",
              "lead_accepted"
            ],
            "type": "string"
          },
          "title": "Event Names",
          "type": "array"
        }
      },
      "title": "AnalyticsIntent",
      "type": "object"
    },
    "Appearance": {
      "additionalProperties": false,
      "properties": {
        "corner": {
          "default": "rounded",
          "enum": [
            "rounded",
            "soft",
            "square"
          ],
          "title": "Corner",
          "type": "string"
        },
        "density": {
          "default": "comfortable",
          "enum": [
            "comfortable",
            "compact"
          ],
          "title": "Density",
          "type": "string"
        },
        "fallback": {
          "$ref": "#/$defs/AppearanceFallback",
          "default": "starter_theme"
        },
        "logo_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Asset Id"
        },
        "missing_inputs": {
          "description": "Observed appearance gaps recorded for review (weak-brand).",
          "items": {
            "type": "string"
          },
          "title": "Missing Inputs",
          "type": "array"
        },
        "profile_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Ref"
        },
        "shadow": {
          "default": "subtle",
          "enum": [
            "none",
            "subtle",
            "elevated"
          ],
          "title": "Shadow",
          "type": "string"
        },
        "tokens": {
          "$ref": "#/$defs/ColorTokens"
        },
        "typography_role": {
          "default": "starter",
          "enum": [
            "starter",
            "display",
            "editorial"
          ],
          "title": "Typography Role",
          "type": "string"
        },
        "wordmark_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wordmark Asset Id"
        }
      },
      "title": "Appearance",
      "type": "object"
    },
    "AppearanceFallback": {
      "enum": [
        "starter_theme",
        "approved_profile"
      ],
      "title": "AppearanceFallback",
      "type": "string"
    },
    "AssetRef": {
      "additionalProperties": false,
      "description": "Governed asset reference. Render must not fetch arbitrary remotes.",
      "properties": {
        "alt_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Alt Text",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "focal_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocalPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "height": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "local_path": {
          "description": "Checked-in relative path under the fixture/public asset root (e.g. 'kleos/tla-linkedin-alumni.png'). Never a remote URL.",
