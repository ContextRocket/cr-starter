{
  "name": "frontend",
  "version": "0.0.8",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/check-openapi.js && pnpm run generate-client",
    "build": "next build --turbopack",
    "build:static": "STATIC_EXPORT=true next build --webpack",
    "start": "next start",
    "start:test": "NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production next start --hostname 127.0.0.1 --port ${PORT:-3100}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n-parity.js",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "generate-client": "openapi-ts",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:ui": "pnpm run build && playwright test --ui",
    "test:e2e:headed": "pnpm run build && playwright test --headed",
    "coverage": "vitest run --coverage",
    "lighthouse": "lhci autorun",
    "trim-assets": "node scripts/trim-assets.js",
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,html}'",
    "tsc": "tsc",
    "test:integration": "pnpm run test:e2e",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run i18n:check && pnpm run test && pnpm run build:static",
    "verify:full": "pnpm run verify && pnpm run test:integration"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "aos": "^2.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.11",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.97.3",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "16.2.11",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/aos": "^3.0.7",
    "@types/node": "^25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.3.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808",
  "pnpm": {
    "overrides": {
      "ajv": "^6.14.0",
      "nanoid": "^3.3.18",
      "js-yaml": "^4.3.1",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=2.0.0 <2.0.3": "^2.0.3",
      "brace-expansion@>=4.0.0 <5.0.6": "^5.0.6",
      "fast-uri": "^3.1.3",
      "picomatch": "^2.3.2",
      "serialize-javascript": "^7.0.5",
      "uuid": "^11.1.1",
      "tmp": "^0.2.4",
      "@babel/core": "^7.29.6",
      "postcss": "^8.5.23",
      "next": "16.2.11",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "flatted": "^3.4.2",
      "sharp": "^0.35.3"
    }
  }
}