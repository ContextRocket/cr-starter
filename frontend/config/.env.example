# ── cr-starter environment reference ──────────────────────────────────────────
# This file is an EXAMPLE only. It is never loaded at runtime.
#
# The app ships with sensible defaults in config/site.config.ts and
# config/site.json, so it runs out of the box with no env file at all.
#
# To override a value, copy this file to .env.local (git-ignored) in this
# same directory and edit the keys you care about. Every value below is
# optional -- omit any key to fall back to the built-in default.

# ── Site Identity ──────────────────────────────────────────────────────────────
# These are read by site.config.ts and used throughout the app.

# Public-facing company / product name (used in headers, titles, JSON-LD)
NEXT_PUBLIC_SITE_NAME=Your Brand

# Canonical production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://contextrocket.com

# Primary contact / support email
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional home-page title override
NEXT_PUBLIC_HOME_TITLE=

# Optional Google Search Console verification token
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Toggle features on/off. All default to "true" unless noted.

# Blog surface (nav link + /blog routes)
NEXT_PUBLIC_BLOG_ENABLED=true

# Chat FAB (floating action button)
NEXT_PUBLIC_CHAT_FAB_ENABLED=true

# Gallery route and browser (the shared lightbox is available independently)
NEXT_PUBLIC_GALLERY_ENABLED=false

# Optional CDN root. Leave empty to serve paths from this site's /public.
# The manifest paths remain unchanged when this is set.
NEXT_PUBLIC_GALLERY_ASSET_BASE_URL=

# Language selector in header
NEXT_PUBLIC_LANGUAGE_SELECTOR_ENABLED=true

# Impressum page (legally required for DE/EU)
NEXT_PUBLIC_IMPRESSUM_ENABLED=true

# Attribution credits page
NEXT_PUBLIC_ATTRIBUTION_ENABLED=true

# Testimonials section on home page
NEXT_PUBLIC_TESTIMONIALS_ENABLED=true

# Shared site chrome style (site.json is the normal fork-owned source)
# Header: marketing, minimal, or none
NEXT_PUBLIC_HEADER_STYLE=marketing
# Footer: full, minimal, or none
NEXT_PUBLIC_FOOTER_STYLE=full
# First-visit theme: system, light, or dark (site.json is the normal source)
NEXT_PUBLIC_DEFAULT_THEME=system

# Powered-by badge visibility
NEXT_PUBLIC_POWERED_BY_BADGE=true

# Dev-only theme preview (?theme= / ?surface= URL overrides). OFF by default so
# forks do not ship the playground; enable here to experiment with themes.
NEXT_PUBLIC_THEME_PLAYGROUND_ENABLED=false

# ── Cookie Consent ────────────────────────────────────────────────────────────
# Controls the cookie consent banner visibility:
#   "auto" (default) - show only when analytics is configured AND consent not recorded
#   "on"             - always show until consent is recorded
#   "off"            - never show
NEXT_PUBLIC_COOKIE_CONSENT=auto

# Cookie consent banner style: "bar" (default), "card", or "terminal"
NEXT_PUBLIC_COOKIE_BANNER_STYLE=bar

# Tip: preview the banner on any page without changing config using the URL
# override `?showbanner` (force show), or `?showbanner=bar|card|terminal` to pin
# a specific layout.

# ── Analytics ─────────────────────────────────────────────────────────────────
# Web Vitals endpoint (empty = disabled)
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# Google Analytics 4 (empty = disabled)
NEXT_PUBLIC_GA_ID=

# PostHog (empty = disabled)
NEXT_PUBLIC_POSTHOG_KEY=

# ── ContextRocket Integration ─────────────────────────────────────────────────
# Chat mode: demo is the default and works in a static export; live calls A2A
# directly from the browser.
NEXT_PUBLIC_CR_CHAT_MODE=demo

# Show the chat fullscreen immediately on page load (false by default).
NEXT_PUBLIC_CHAT_FULLSCREEN_ON_LOAD=false

# ContextRocket A2A base URL (required for live mode)
NEXT_PUBLIC_CR_AGENT_URL=

# Public ContextRocket ID (tenant identity, not a secret)
NEXT_PUBLIC_CONTEXTROCKET_ID=

# Optional publishable browser API key for live embed/A2A access. Do not put a
# server-side crk_ machine credential in a public Next.js build.
NEXT_PUBLIC_CONTEXTROCKET_API_KEY=

# ── Deployment ────────────────────────────────────────────────────────────────
# Set to "true" for static export (S3 + CloudFront)
STATIC_EXPORT=false

# ── Blog ──────────────────────────────────────────────────────────────────────
# Public URL segment for the blog (default: /blog)
BLOG_BASE_PATH=/blog

# Human-facing blog name (default: Blog)
BLOG_TITLE=Blog

# ── Forms ─────────────────────────────────────────────────────────────────────
# Form submission endpoints (empty = UI-only, no network call)
SUBSCRIBE_ENDPOINT=
WAITLIST_ENDPOINT=
CONTACT_ENDPOINT=
