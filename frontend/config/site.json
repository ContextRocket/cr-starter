{
  "company": {
    "name": "Your Brand",
    "legalName": "Your Brand GmbH",
    "tagline": "A clear place to start.",
    "description": "A simple, flexible starting point for a clear and maintainable website.",
    "siteUrl": "https://contextrocket.com",
    "contactEmail": "hello@example.com"
  },
  "defaultLocale": "en",
  "locales": ["en", "es", "de"],
  "publicRoutes": [
    {
      "key": "home",
      "path": "",
      "indexable": true,
      "priority": 1,
      "changeFrequency": "daily"
    },
    {
      "key": "features",
      "path": "features",
      "indexable": true,
      "includeInLlms": true,
      "priority": 0.7,
      "changeFrequency": "monthly"
    },
    {
      "key": "blog",
      "path": "blog",
      "feature": "blog",
      "indexable": true,
      "includeInLlms": true,
      "priority": 0.8,
      "changeFrequency": "daily"
    },
    {
      "key": "faq",
      "path": "faq",
      "indexable": true,
      "includeInLlms": true,
      "priority": 0.7,
      "changeFrequency": "monthly"
    },
    {
      "key": "privacy",
      "path": "privacy",
      "indexable": true,
      "includeInLlms": true,
      "priority": 0.3,
      "changeFrequency": "monthly"
    },
    {
      "key": "impressum",
      "path": "impressum",
      "feature": "impressum",
      "indexable": true,
      "includeInLlms": true,
      "priority": 0.3,
      "changeFrequency": "monthly"
    },
    {
      "key": "attribution",
      "path": "attribution",
      "feature": "attribution",
      "indexable": true,
      "includeInLlms": true,
      "priority": 0.3,
      "changeFrequency": "monthly"
    }
  ],
  "assets": {
    "logo": "/brand/cr-icon-red.svg",
    "logoDark": "/brand/cr-icon-white.svg",
    "wordmark": "/cr-logo.svg",
    "wordmarkDark": "/brand/cr-logo-horizontal-white.png",
    "faviconIco": "/favicon.ico",
    "icon16": "/favicon-16x16.png",
    "icon32": "/favicon-32x32.png",
    "appleTouchIcon": "/apple-icon-180x180.png",
    "icon192": "/icon-192.png",
    "icon512": "/icon-512.png",
    "icon192Maskable": "/icon-192-maskable.png",
    "icon512Maskable": "/icon-512-maskable.png"
  },
  "nav": {
    "showAppLinks": false,
    "links": [
      {
        "labelKey": "nav.blog",
        "href": "/blog"
      }
    ],
    "footerLinks": [
      {
        "labelKey": "footer.impressum",
        "href": "/impressum"
      },
      {
        "labelKey": "footer.privacy",
        "href": "/privacy"
      },
      {
        "labelKey": "footer.faq",
        "href": "/faq"
      },
      {
        "labelKey": "footer.attribution",
        "href": "/attribution"
      }
    ]
  },
  "stats": [
    {
      "value": "01",
      "labelKey": "home.stats.output"
    },
    {
      "value": "02",
      "labelKey": "home.stats.integrations"
    },
    {
      "value": "03",
      "labelKey": "home.stats.uptime"
    }
  ],
  "chrome": {
    "header": "marketing",
    "footer": "full",
    "logoVariant": "icon",
    "showBrandLogo": true,
    "showThemeToggle": true,
    "defaultTheme": "system",
    "cookieBannerStyle": "bar",
    "exemptPrefixes": ["/terminal-demo"]
  },
  "features": {
    "blog": true,
    "chatFab": true,
    "gallery": false,
    "languageSelector": true,
    "impressum": true,
    "attribution": true,
    "testimonials": false,
    "poweredByBadge": true,
    "cookieConsent": "auto"
  },
  "chat": {
    "fullscreenOnLoad": false
  },
  "gallery": {
    "manifestPath": "content/gallery.json",
    "assetBaseUrl": "",
    "profileImageId": ""
