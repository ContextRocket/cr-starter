# Backend API base URL (server-side; used by API client)
API_BASE_URL=http://localhost:8000

# Backend API base URL (client-side; used by browser, e.g. chat stream)
# Set both to your backend URL in production (e.g. Vercel)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# OpenAPI generated file path (relative to the frontend directory)
# IMPORTANT: This must match OPENAPI_OUTPUT_FILE in backend config
# Backend generates to: ../local-shared-data/openapi.json (from backend/)
# Frontend reads from: ../local-shared-data/openapi.json (from frontend/)
OPENAPI_OUTPUT_FILE=../local-shared-data/openapi.json

# ── Analytics (optional, consent-gated) ───────────────────────────────────────
# Leave blank to disable. Analytics loads ONLY after the user grants cookie
# consent. Declining consent keeps the site fully functional.
# GDPR: consent-first is the shipped default -- no analytics fires before accept.
#
# Google Analytics 4: paste your Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PostHog: paste your project API key and optionally override the host
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=