# frontend/.env.example -- copy to frontend/.env.local and adjust.
# These vars are loaded by Next.js from the frontend/ directory.
# NEXT_PUBLIC_* vars are baked into the browser bundle at build time.

# ── ContextRocket A2A endpoint ────────────────────────────────────────────────
# Required: bare origin URL of your ContextRocket agent (no path suffix).
# The SDK appends /api/agent/a2a internally -- do not include that path here.
# Get this from the ContextRocket dashboard under Settings > Credentials.
NEXT_PUBLIC_CR_AGENT_URL=https://app.contextrocket.com

# Optional: org machine credential key (crk_-prefixed).
# When set, A2A calls include this as the OrgCredential header for org-scoped access.
# Leave blank to use anonymous/guest access.
NEXT_PUBLIC_CR_ORG_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to show the Chat FAB on every page.
NEXT_PUBLIC_CHAT_FAB_ENABLED=true

# Set to "true" to enable the optional local fastapi-users backend.
# When "false" (default), guest auth is skipped and A2A runs without identity.
NEXT_PUBLIC_BACKEND_ENABLED=false

# ── Backend URLs (used when NEXT_PUBLIC_BACKEND_ENABLED=true) ─────────────────
# Server-side API base URL (used by server actions and SSR; not exposed to browser)
API_BASE_URL=http://localhost:8100

# Client-side API base URL (used by browser fetch; must be reachable from the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100

# ── OpenAPI client codegen ────────────────────────────────────────────────────
# Path to the shared OpenAPI schema (relative to the frontend directory).
# Must match OPENAPI_OUTPUT_FILE in backend config; both resolve to:
#   <project-root>/local-shared-data/openapi.json
OPENAPI_OUTPUT_FILE=../local-shared-data/openapi.json

# ── Analytics (optional, consent-gated) ───────────────────────────────────────
# Leave blank to disable. Analytics loads ONLY after the user grants cookie
# consent. Declining consent keeps the site fully functional.
# GDPR: consent-first is the shipped default -- no analytics fires before accept.
#
# Google Analytics 4: paste your Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PostHog: paste your project API key and optionally override the host
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
