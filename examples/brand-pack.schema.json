{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextrocket.com/schemas/brand-pack.v1.json",
  "title": "ContextRocket brand pack v1",
  "description": "Style artifacts for a simple nav+hero landing. Copy is shared boilerplate — not part of the pack.",
  "type": "object",
  "required": ["version", "identity", "colors", "assets"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "capturedAt": { "type": "string" },
        "method": { "type": "string", "enum": ["manual", "agent", "crawl"] },
        "notes": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "legalName": { "type": "string" },
        "siteUrl": { "type": "string" },
        "contactEmail": { "type": "string" }
      }
    },
    "colors": {
      "type": "object",
      "required": ["background", "foreground", "primary", "accent"],
      "additionalProperties": false,
      "properties": {
        "background": { "type": ["string", "null"] },
        "foreground": { "type": ["string", "null"] },
        "primary": { "type": ["string", "null"] },
        "accent": { "type": ["string", "null"] },
        "provenance": {
          "type": "object",
          "description": "Where each role came from; never invent brand hues",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "observed": {
          "type": "array",
          "description": "Raw extracted color samples for review",
          "items": {
            "type": "object",
            "required": ["role", "hex"],
            "properties": {
              "role": { "type": "string" },
              "hex": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string", "description": "Google Font used in lab" },
        "requestedFontFamily": { "type": "string", "description": "Family from crawl" },
        "fontFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "weight"],
            "properties": {
              "path": { "type": "string" },
              "weight": { "type": ["string", "number"] },
              "style": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "assets": {
      "type": "object",
      "required": ["logo"],
      "additionalProperties": true,
      "properties": {
        "logo": { "type": "string" },
        "favicon": { "type": "string" },
        "favicon32": { "type": "string" },
        "appleTouch": { "type": "string" },
        "logoAnalysis": { "type": "object" },
        "candidates": { "type": "array" }
      }
    },
    "landing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": { "type": "string", "enum": ["light-hero"], "default": "light-hero" }
      }
    }
  }
}
