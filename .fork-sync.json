{
  "schemaVersion": 1,
  "projectType": "starter-astro",
  "_comment": [
    "cr-starter (Astro) is the ROOT of the public static brand-fork family.",
    "It has no parent. Auth-line repos (cr-auth-starter, Luna) are NOT sync",
    "children of this tree -- they remain on a separate Next + API line.",
    "Brand forks (kleos, markmacmahon, gba, …) customize config/content/home."
  ],
  "policy": {
    "sync": [
      "src/layouts/**",
      "src/components/chrome/**",
      "src/components/pages/LegalPage.astro",
      "src/components/pages/AttributionPage.astro",
      "src/components/pages/BlogIndex.astro",
      "src/components/pages/BlogPost.astro",
      "src/lib/**",
      "src/config/site.config.ts",
      "src/i18n/keys.ts",
      "src/i18n/translator.ts",
      "src/i18n/locales.ts",
      "src/i18n/messages/shared/**",
      "src/i18n/messages/app/**",
      "src/i18n/messages/modules/**",
      "src/i18n/messages/registry.ts",
      "src/styles/**",
      "src/pages/404.astro",
      "src/pages/sitemap.xml.ts",
      "src/pages/robots.txt.ts",
      "src/pages/llms.txt.ts",
      "src/pages/feed.xml.ts",
      "src/pages/manifest.webmanifest.ts",
      "src/pages/.well-known/**",
      "src/pages/attribution/**",
      "src/pages/[locale]/attribution/**",
      "docs/fork-evolution.md",
      "docs/publish-contract.md",
      "scripts/alias-blog-path.mjs",
      "scripts/blog-path-alias.mjs",
      "scripts/flatten-single-locale.mjs",
      "scripts/validate-theme.mjs",
      "scripts/check-i18n-parity.cjs",
      "scripts/check-behavior-ids.mjs",
      "scripts/smoke-routes.mjs",
      "astro.config.mjs",
      "blog.config.mjs"
    ],
    "preserve": [
      "config/site.json",
      "src/i18n/messages/site/**",
      "src/components/custom/**",
      "src/pages/[locale]/index.astro",
      "public/**",
      "content/**"
    ]
  }
}
