{
  "name": "cr-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ContextRocket public static starter (Astro + Tailwind)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/flatten-single-locale.mjs && node scripts/emit-static-redirects.mjs",
    "build:container": "CONTAINER_BASE=/site astro build && node scripts/flatten-single-locale.mjs && node scripts/emit-static-redirects.mjs && CONTAINER_BASE=/site node scripts/containerize-dist.mjs",
    "preview": "astro preview",
    "publish:site": "node ../cr-sdk/packages/site-publisher/dist/cli.js dist --manifest publication.json",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings 0",
    "i18n:check": "node scripts/check-i18n-parity.cjs",
    "theme:check": "node scripts/validate-theme.mjs",
    "check:behavior-ids": "node scripts/check-behavior-ids.mjs",
    "check:embed-artifacts": "node scripts/check-embed-artifacts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run check:behavior-ids && pnpm run check:embed-artifacts && pnpm run theme:check && pnpm run i18n:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && node scripts/smoke-routes.mjs",
    "smoke": "node scripts/smoke-routes.mjs",
    "build:widget": "pnpm --dir ../cr-sdk/packages/embed-chat build && node scripts/sync-embed-artifact.mjs widget",
    "build:contact-form": "pnpm --dir ../cr-sdk/packages/sdk build && node scripts/sync-embed-artifact.mjs contact-form",
    "build:site-behaviors": "pnpm --dir ../cr-sdk/packages/sdk build && node scripts/sync-embed-artifact.mjs site-behaviors",
    "build:embeds": "pnpm --dir ../cr-sdk/packages/sdk run build && node ../cr-sdk/packages/embed-chat/build.mjs && node scripts/sync-embed-artifact.mjs widget && node scripts/sync-embed-artifact.mjs contact-form && node scripts/sync-embed-artifact.mjs site-behaviors"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "astro": "^5.13.2",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.17.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
