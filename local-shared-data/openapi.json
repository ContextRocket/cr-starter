    "/auth/guest": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create Guest",
        "description": "Create an ephemeral guest account and return a short-lived Bearer JWT.\n\nThe generated email (guest-<uuid>@guest.example) is intentionally unusable\nfor login.  The hashed password is a random UUID \u2014 also not usable.\nis_guest=True marks the account for conversion.\n\nThe JWT lifetime is controlled by GUEST_TOKEN_LIFETIME_SECONDS (default 72h).",
        "operationId": "create_guest",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/convert": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Convert Guest",
        "description": "Convert a guest account to a permanent account.\n\nThe caller must present a valid guest Bearer JWT. The SAME user row is\nupdated in-place (email + hashed_password + is_guest=False) so the user id\nis preserved and any ContextRocket-side session context survives intact.",
        "operationId": "convert_guest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConvertRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/operator/users": {
      "get": {
        "tags": [
          "operator"
        ],
        "summary": "List Users",
        "description": "Return a paginated list of users for operator review.\n\nOnly accessible to superusers.  Returns id, email, is_guest, and\nis_active.  No sensitive fields (hashed_password, etc.) are exposed.",
        "operationId": "list_users",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/magic-link/request": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Request Passwordless",
        "operationId": "request_passwordless",
        "parameters": [
          {
            "name": "X-CR-E2E-Passwordless-Secret",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Cr-E2E-Passwordless-Secret"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordlessRequestBody"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordlessE2eRevealResponse"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/magic-link/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Verify Passwordless",
        "operationId": "verify_passwordless",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordlessVerifyBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordlessVerifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
