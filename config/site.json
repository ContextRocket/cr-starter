{
  "company": {
    "name": "ContextRocket",
    "tagline": "A clear place to start.",
    "description": "A simple, flexible starting point for a clear and maintainable website.",
    "siteUrl": "https://example.com",
    "contactEmail": ""
  },
  "contextrocket": {
    "handle": "contextrocket",
    "subjectKind": "company"
  },
  "integrations": {},
  "integrationConsentMode": "auto",
  "titleSeparator": "·",
  "defaultLocale": "en",
  "trailingSlash": "always",
  "redirects": [],
  "locales": [
    "en",
    "es",
    "de"
  ],
  "publicRoutes": [
    {
      "key": "home",
      "path": "",
      "indexable": true,
      "priority": 1,
      "changeFrequency": "daily"
    },
    {
      "key": "blog",
      "path": "blog",
      "feature": "blog",
      "indexable": true,
      "includeInLlms": true,
      "priority": 0.8,
      "changeFrequency": "daily"
    },
    {
      "key": "contact",
      "path": "contact",
      "indexable": true,
      "priority": 0.5,
      "changeFrequency": "yearly"
    }
  ],
  "assets": {
    "logo": "https://contextrocket.cdn.contextrocket.com/brand/icon-tile-ink.svg",
    "wordmark": "https://contextrocket.cdn.contextrocket.com/brand/logo-h-spark-ink.svg",
    "faviconIco": "/favicon.ico",
    "icon16": "/favicon-16x16.png",
    "icon32": "/favicon-32x32.png",
    "appleTouchIcon": "/apple-icon-180x180.png",
    "icon192": "/icon-192.png",
    "icon512": "/icon-512.png",
    "icon192Maskable": "/icon-192-maskable.png",
    "icon512Maskable": "/icon-512-maskable.png"
  },
  "nav": {
    "showAppLinks": false,
    "links": [
      {
        "labelKey": "nav.blog",
        "href": "/blog"
      },
      {
        "labelKey": "nav.contact",
        "href": "/contact"
      }
    ],
    "footerLinks": [
      {
        "labelKey": "nav.contact",
        "href": "/contact"
      }
    ]
  },
  "chrome": {
    "header": "marketing",
    "footer": "full",
    "navBreakpoint": "lg",
    "logoVariant": "wordmark",
    "poweredByTone": "ink",
    "showBrandLogo": true,
    "cookieBannerStyle": "dock",
    "exemptPrefixes": []
  },
  "features": {
    "blog": true,
    "topics": false,
    "chatFab": true,
    "languageSelector": true,
    "poweredByBadge": true,
    "cookieConsent": "auto"
  },
  "chat": {
    "widgetSrc": "/embed/widget.js",
    "position": "bottom-right",
    "fullscreen": true,
    "fullscreenOnOpen": false,
    "fullscreenOnLoad": false,
    "launcherColor": "pink"
  },
  "contactForm": {
    "mode": "demo",
    "scriptSrc": "/embed/contact-form.js"
  },
  "theme": {
    "radius": "0.5rem",
    "tokens": {
      "--background": "#FAF9F6",
      "--foreground": "#0E0F13",
      "--card": "#FFFFFF",
      "--card-foreground": "#0E0F13",
      "--popover": "#FFFFFF",
      "--popover-foreground": "#0E0F13",
      "--primary": "#0E0F13",
      "--primary-foreground": "#FFFFFF",
      "--primary-hover": "#292A2F",
      "--primary-soft": "rgba(14,15,19,0.08)",
      "--brand-accent": "#0E0F13",
      "--brand-accent-foreground": "#FFFFFF",
      "--brand-accent-hover": "#292A2F",
      "--secondary": "#F4F2ED",
      "--secondary-foreground": "#0E0F13",
      "--secondary-hover": "#ECE9E2",
      "--secondary-soft": "rgba(0,0,0,0.05)",
      "--tertiary": "#ECE9E2",
      "--tertiary-foreground": "#0E0F13",
      "--tertiary-hover": "#d4d4d4",
      "--tertiary-soft": "rgba(0,0,0,0.05)",
      "--muted": "#F4F2ED",
      "--muted-foreground": "#5E616B",
      "--accent": "#F4F2ED",
      "--accent-foreground": "#0E0F13",
      "--destructive": "#ef4444",
      "--destructive-foreground": "#fafafa",
      "--border": "#E3E0D9",
      "--input": "#E3E0D9",
      "--ring": "#0E0F13",
      "--text-secondary": "#5E616B",
      "--text-tertiary": "#777A83",
      "--card-border": "#E3E0D9",
      "--success": "#10b981",
      "--success-foreground": "#ffffff",
      "--warning": "#fbbf24",
      "--warning-foreground": "#0a0a0a",
      "--info": "#3b82f6",
      "--info-foreground": "#ffffff",
      "--error": "#ef4444",
      "--error-foreground": "#ffffff",
      "--disabled": "#e5e7eb",
      "--disabled-foreground": "#9ca3af"
    }
  },
  "social": {
    "twitter": "",
    "linkedin": "",
    "github": ""
  }
}
