---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site.config";
import { createT } from "@/i18n/keys";
import ContactFormSection from "@/components/contact/ContactFormSection.astro";
import type { SupportedLocale } from "@/i18n/locales";
import { absoluteUrl, localizedHref } from "@/lib/paths";
import { buildBreadcrumbListJsonLd } from "@/lib/structured-data";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = createT(locale);
const path = "/contact";
const title = t("contact.title");
const jsonLdExtra = [buildBreadcrumbListJsonLd([
  { name: t("breadcrumb.home"), url: absoluteUrl(localizedHref(locale, "/")) },
  { name: title, url: absoluteUrl(localizedHref(locale, path)) },
])];
---

<BaseLayout locale={locale} title={title} description={t("contact.introduction")} path={path} includeSiteJsonLd={false} jsonLdExtra={jsonLdExtra}>
  <main id="main-content" tabindex="-1" class="px-5 py-14 sm:px-8 sm:py-20">
    <ContactFormSection
      locale={locale}
      id="contact-form"
      eyebrow={siteConfig.companyName}
      title={title}
      description={t("contact.introduction")}
      headingAs="h1"
    >
      {siteConfig.contactEmail && <p slot="after-form" class="mt-6 text-sm text-text-secondary">{t("contact.directEmail")} <a class="font-medium text-foreground underline underline-offset-4" href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></p>}
    </ContactFormSection>
  </main>
</BaseLayout>
