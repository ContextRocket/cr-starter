---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { SupportedLocale } from "@/i18n/locales";
import { getPost, blogPublicBasePath } from "@/lib/blog";
import { blogIndexHref, absoluteUrl, localizedHref } from "@/lib/paths";
import { createT } from "@/i18n/keys";
import { siteConfig } from "@/config/site.config";
import { buildBlogPostingJsonLd, buildBreadcrumbListJsonLd } from "@/lib/structured-data";
import BlogContents from "@/components/blog/BlogContents.astro";

interface Props {
  locale: SupportedLocale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = createT(locale);
const post = getPost(slug, locale);
if (!post) throw new Error(`Missing post ${slug} for ${locale}`);
const hasContents = post.sections.length >= 4;

const path = `${blogPublicBasePath()}/${slug}`;
const postUrl = absoluteUrl(localizedHref(locale, path));
const indexUrl = absoluteUrl(blogIndexHref(locale));
const dateLabel = new Date(`${post.date}T00:00:00Z`).toLocaleDateString(locale, {
  year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
});
const readingMinutes = Math.max(1, Math.ceil(post.bodyMarkdown.trim().split(/\s+/).length / 200));
const jsonLdExtra = [
  buildBlogPostingJsonLd({
    title: post.title,
    description: post.excerpt || siteConfig.description,
    url: postUrl,
    datePublished: post.date,
    authorName: post.author || siteConfig.companyName,
    imageUrl: post.image,
  }),
  buildBreadcrumbListJsonLd([
    { name: t("breadcrumb.home"), url: absoluteUrl(localizedHref(locale, "/")) },
    { name: t("blog.title"), url: indexUrl },
    { name: post.title, url: postUrl },
  ]),
];
---

<BaseLayout locale={locale} title={post.title} titleSuffix={siteConfig.blog.postTitleSuffix} description={post.excerpt} path={path} ogType="article" image={post.image} includeSiteJsonLd={false} jsonLdExtra={jsonLdExtra}>
  <main id="main-content" tabindex="-1" class="px-5 py-12 sm:px-8 sm:py-20">
    <article class:list={["mx-auto", hasContents ? "max-w-6xl" : "max-w-3xl"]}>
      <a href={blogIndexHref(locale)} class="text-sm font-medium text-text-secondary underline-offset-4 hover:text-foreground hover:underline">← {t("blog.title")}</a>
      <header class:list={["mt-8", hasContents && "max-w-3xl"]}>
        <p class="text-sm text-text-tertiary"><time datetime={post.date}>{dateLabel}</time><span aria-hidden="true"> · </span>{readingMinutes} {t("blog.min.read")}{post.author && <><span aria-hidden="true"> · </span>{post.author}</>}</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">{post.title}</h1>
        {post.excerpt && <p class="mt-5 text-xl leading-8 text-text-secondary">{post.excerpt}</p>}
      </header>
      {post.image && <img src={post.image} alt="" fetchpriority="high" class="mx-auto mt-9 aspect-[16/9] w-full max-w-3xl rounded-2xl object-cover" />}
      <div class:list={["mt-10", hasContents && "grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-start"]}>
        {hasContents && <BlogContents sections={post.sections} locale={locale} />}
        <div class="prose prose-neutral min-w-0 max-w-none" set:html={post.bodyHtml} />
      </div>
    </article>
  </main>
</BaseLayout>
