---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { SupportedLocale } from "@/i18n/locales";
import { listTopics } from "@/lib/topics";
import { absoluteUrl, localizedHref } from "@/lib/paths";
import { blogPublicBasePath } from "@/lib/blog";
import { createT } from "@/i18n/keys";
import { buildBreadcrumbListJsonLd } from "@/lib/structured-data";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = createT(locale);
const topics = listTopics();
const path = `${blogPublicBasePath()}/topics`;
const title = t("blog.topics");
const description = t("blog.topics_description");
const jsonLdExtra = [buildBreadcrumbListJsonLd([
  { name: t("breadcrumb.home"), url: absoluteUrl(localizedHref(locale, "/")) },
  { name: t("blog.title"), url: absoluteUrl(localizedHref(locale, blogPublicBasePath())) },
  { name: title, url: absoluteUrl(localizedHref(locale, path)) },
])];
---

<BaseLayout locale={locale} title={title} description={description} path={path} includeSiteJsonLd={false} jsonLdExtra={jsonLdExtra}>
  <main id="main-content" tabindex="-1" class="bg-background px-5 py-14 sm:px-8 sm:py-20">
    <header class="mx-auto max-w-3xl text-center">
      <a href={localizedHref(locale, blogPublicBasePath())} class="text-sm font-medium text-text-secondary underline-offset-4 hover:text-foreground hover:underline">← {t("blog.title")}</a>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg leading-8 text-text-secondary sm:text-xl">{description}</p>
    </header>
    {topics.length > 0 ? (
      <ul class:list={["mx-auto mt-12 grid items-stretch gap-5", topics.length === 1 ? "max-w-2xl grid-cols-1" : "max-w-5xl sm:grid-cols-2"]}>
        {topics.map((topic) => (
          <li class:list={["min-w-0", topics.length === 1 && "mx-auto w-full max-w-2xl"]}>
            <a href={localizedHref(locale, `${path}/${topic.slug}`)} class="group flex h-full flex-col rounded-2xl border border-border bg-card p-7 text-card-foreground transition-colors hover:border-primary/40">
              <h2 class="text-xl font-semibold tracking-tight group-hover:underline group-hover:underline-offset-4">{topic.title}</h2>
              <p class="mt-3 flex-1 leading-7 text-text-secondary">{topic.description}</p>
              <span class="mt-6 text-sm font-medium text-text-secondary">{t("blog.updated")} <time datetime={topic.updated}>{topic.updated}</time> <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mx-auto mt-12 max-w-xl text-center text-text-secondary">{t("blog.topics_empty")}</p>
    )}
  </main>
</BaseLayout>
