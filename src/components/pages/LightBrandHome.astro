---
/**
 * Light brand landing — style chrome + boilerplate hero.
 * Nav (logo/name + CTA) and one main section. Copy is placeholder only.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createT } from "@/i18n/keys";
import type { SupportedLocale } from "@/i18n/locales";
import { siteConfig } from "@/config/site.config";
import brandLanding from "../../../config/brand-landing.json";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = createT(locale);

const hints = (brandLanding as {
  primaryHref?: string;
  secondaryHref?: string;
}) || {};

const logoSrc =
  siteConfig.assets.wordmark ||
  siteConfig.assets.logo ||
  "/brand/cr-icon-red.svg";
const brandName = siteConfig.companyName;
const primaryHref = hints.primaryHref || "#";
const secondaryHref = hints.secondaryHref || "#about";
const showLogo = siteConfig.chrome.showBrandLogo !== false;
---

<BaseLayout locale={locale} path="/">
  <header class="border-b border-border/80 bg-background/90 backdrop-blur-sm">
    <div
      class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-6 sm:px-8"
    >
      <a href="/" class="inline-flex items-center gap-3 text-foreground">
        {
          showLogo ? (
            <img
              src={logoSrc}
              alt=""
              class="h-7 w-auto"
              width="120"
              height="28"
            />
          ) : null
        }
        <span class="text-sm font-semibold tracking-tight">{brandName}</span>
      </a>
      <a
        href={primaryHref}
        class="inline-flex items-center rounded-md bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
      >
        {t("home.hero.primaryCta")}
      </a>
    </div>
  </header>

  <main class="bg-background text-foreground">
    <section
      class="relative mx-auto flex min-h-[calc(100svh-3.5rem)] max-w-5xl flex-col justify-center px-6 py-20 sm:px-8"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--brand-accent)_0%,_transparent_50%)] opacity-[0.1]"
      >
      </div>

      <div class="max-w-2xl">
        <h1
          class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl"
        >
          {t("home.hero.headline")}
        </h1>
        <p
          class="mt-6 max-w-xl text-lg leading-8 text-muted-foreground sm:text-xl"
        >
          {t("home.hero.subhead")}
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={primaryHref}
            class="inline-flex items-center rounded-md bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            {t("home.hero.primaryCta")}
          </a>
          <a
            href={secondaryHref}
            class="text-sm font-semibold text-foreground/75 transition-colors hover:text-foreground"
          >
            {t("home.hero.secondaryCta")}
            <span aria-hidden="true"> →</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
