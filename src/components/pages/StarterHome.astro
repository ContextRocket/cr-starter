---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site.config";
import type { SupportedLocale } from "@/i18n/locales";
import { createT } from "@/i18n/keys";
import { listPosts } from "@/lib/blog";
import { blogIndexHref, blogPostHref, localizedHref } from "@/lib/paths";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = createT(locale);
const posts = siteConfig.features.blog ? listPosts(locale).slice(0, 3) : [];
const contactHref = localizedHref(locale, "/contact");
---

<BaseLayout locale={locale} path="/">
  <main>
    <section class="mx-auto max-w-6xl px-5 pb-16 pt-20 sm:px-8 sm:pb-24 sm:pt-28">
      <div class="max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-text-secondary">
          {siteConfig.companyName}
        </p>
        <h1 class="mt-5 text-4xl font-semibold tracking-tight text-foreground sm:text-6xl">
          {siteConfig.tagline}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-text-secondary sm:text-xl">
          {siteConfig.description}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          {siteConfig.features.blog && (
            <a href={blogIndexHref(locale)} class="rounded-full bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
              {siteConfig.blog.title}
            </a>
          )}
          <a href={contactHref} class="rounded-full border border-border px-5 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
            {t("nav.contact")}
          </a>
        </div>
      </div>
    </section>

    {posts.length > 0 && (
      <section class="border-t border-border bg-muted/35 px-5 py-16 sm:px-8 sm:py-20">
        <div class="mx-auto max-w-6xl">
          <div class="mb-8 flex items-end justify-between gap-4">
            <div>
              <p class="text-sm font-medium uppercase tracking-[0.16em] text-text-secondary">{t("blog.featured")}</p>
              <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">{siteConfig.blog.title}</h2>
            </div>
            <a href={blogIndexHref(locale)} class="shrink-0 text-sm font-semibold text-foreground underline-offset-4 hover:underline">{t("blog.all_posts")} <span aria-hidden="true">→</span></a>
          </div>
          <ul class="grid items-stretch gap-5 md:grid-cols-3">
            {posts.map((post) => (
              <li class="min-w-0">
                <a href={blogPostHref(locale, post.slug)} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card transition-shadow hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                  {post.image ? <img src={post.image} alt="" loading="lazy" class="aspect-[16/9] w-full object-cover" /> : <div aria-hidden="true" class="aspect-[16/9] w-full bg-muted" />}
                  <div class="flex flex-1 flex-col p-5">
                    <h3 class="line-clamp-2 min-h-14 text-lg font-semibold leading-7 group-hover:underline">{post.title}</h3>
                    <time class="mt-2 text-sm text-text-tertiary" datetime={post.date}>{post.date}</time>
                    <p class="mt-3 line-clamp-3 min-h-[4.5rem] text-sm leading-6 text-text-secondary">{post.excerpt ?? ""}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</BaseLayout>
