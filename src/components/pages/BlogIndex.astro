---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { SupportedLocale } from "@/i18n/locales";
import { listPosts, blogPublicBasePath } from "@/lib/blog";
import { absoluteUrl, localizedHref } from "@/lib/paths";
import { createT } from "@/i18n/keys";
import { buildBreadcrumbListJsonLd } from "@/lib/structured-data";
import BlogPostCard from "@/components/blog/BlogPostCard.astro";
import { listTopics } from "@/lib/topics";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = createT(locale);
const posts = listPosts(locale);
const topics = listTopics();
const title = t("blog.title");
const description = t("blog.subtitle");
const path = blogPublicBasePath();
const jsonLdExtra = [
  buildBreadcrumbListJsonLd([
    { name: t("breadcrumb.home"), url: absoluteUrl(localizedHref(locale, "/")) },
    { name: title, url: absoluteUrl(localizedHref(locale, path)) },
  ]),
];
---

<BaseLayout locale={locale} title={title} description={description} path={path} includeSiteJsonLd={false} jsonLdExtra={jsonLdExtra}>
  <main id="main-content" tabindex="-1" class="bg-background px-5 py-14 sm:px-8 sm:py-20">
    <header class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">{title}</h1>
      {description && <p class="mt-4 text-lg leading-8 text-text-secondary sm:text-xl">{description}</p>}
      {topics.length > 0 && <a href={localizedHref(locale, `${path}/topics`)} class="mt-5 inline-flex text-sm font-medium text-text-secondary underline-offset-4 hover:text-foreground hover:underline">{t("blog.topics")} <span class="ml-2" aria-hidden="true">→</span></a>}
    </header>

    {posts.length > 0 ? (
      <ul class="mx-auto mt-12 grid max-w-6xl items-stretch gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-6">
        {posts.map((post, index) => (
          <li
            class:list={[
              "min-w-0 lg:col-span-2",
              posts.length % 2 === 1 && index === posts.length - 1 && "sm:col-start-2",
              posts.length % 3 === 1 && index === posts.length - 1 && "lg:col-start-3",
              posts.length % 3 === 2 && index === posts.length - 2 && "lg:col-start-2",
              posts.length % 3 === 2 && index === posts.length - 1 && "lg:col-start-4",
            ]}
          >
            <BlogPostCard post={post} locale={locale} priority={index === 0} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="mx-auto mt-12 max-w-xl text-center text-text-secondary">{t("blog.empty")}</p>
    )}
  </main>
</BaseLayout>
