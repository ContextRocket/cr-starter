---
import { assetHref } from '@/lib/paths';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContextRocketBadge from '@/components/chrome/ContextRocketBadge.astro';
import { siteConfig } from '@/config/site.config';
import GeneratedContactForm from './GeneratedContactForm.astro';
import type { GeneratedContactFormView } from '@/lib/generated-contact-form';
import { object, text, array, type BuildInputs } from '../../../scripts/generated-page/validate';
interface Props { manifest: Record<string, unknown>; input: BuildInputs }
const { manifest, input }=Astro.props;
const sections=array(manifest.sections).map(object).filter(s=>s.visible !== false).sort((a,b)=>Number(a.order)-Number(b.order));
const assets=array(manifest.assets).map(object);
const search=object(manifest.search);
const images=(section:Record<string,unknown>)=>array(section.asset_ids ?? []).map(id=>assets.find(a=>a.asset_id===id)!);
function contactFormView(section:Record<string,unknown>): GeneratedContactFormView {
  const b=object(section.binding);
  return {
    id:text(section.id), title:text(section.title), description:section.description ? text(section.description):undefined,
    appRef:text(b.public_app_ref),orgHandle:input.organizationHandle,apiOrigin:input.contact!.apiOrigin,
    fields:array(b.fields).map(object).map(f=>({ name:text(f.name) as GeneratedContactFormView['fields'][number]['name'], label:text(f.label),fieldType:text(f.field_type ?? 'text') as GeneratedContactFormView['fields'][number]['fieldType'],required:f.required !== false })),
    consentText:text(b.consent_text),privacyUrl:text(b.privacy_url),successMessage:text(b.success_message),validationMessage:text(b.validation_error_message),unavailableMessage:text(b.unavailable_message),
    attribution:{campaign_ref:b.campaign_ref ? text(b.campaign_ref):undefined, landing_page_ref:b.landing_page_ref ? text(b.landing_page_ref):undefined,site_release_ref:b.release_ref ? text(b.release_ref):undefined,variant_ref:b.variant_ref ? text(b.variant_ref):undefined,controller_mode:b.data_controller_mode === 'contextrocket' ? 'contextrocket_operator':'organization'},
  };
}
function ctaHref(section:Record<string,unknown>):string {
  if(section.destination_kind !== 'form_binding') return text(section.href);
  return `#${text(sections.find(s=>s.type==='contact_form' && object(s.binding).binding_id===section.form_binding_id)!.id)}`;
}
---
<BaseLayout locale="en" path={input.mount} title={text(search.title)} titleIsExact description={text(search.description)} robots={text(search.robots_intent) as 'index,follow' | 'noindex,nofollow'} includeSiteJsonLd={false} fontAssets={{}} navigation={input.navigation ? { ...input.navigation, homeHref: input.navigation.homeHref ?? `${input.publicOrigin}/` } : undefined}>
  <main id="main-content" class="mx-auto w-full max-w-5xl space-y-12 px-6 py-12">
    {sections.map(s=> s.type==='contact_form' ? <GeneratedContactForm view={contactFormView(s)} /> : (
      <section id={text(s.id)} class="space-y-5">
        {s.type==='hero' ? <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">{text(s.headline)}</h1> : s.title && <h2 class="text-3xl font-semibold">{text(s.title)}</h2>}
        {(s.subhead || s.subtitle || s.description || s.eyebrow) && <p class="text-lg text-muted-foreground">{text(s.subhead || s.subtitle || s.description || s.eyebrow)}</p>}
        {array(s.paragraphs ?? s.body ?? []).map(p=><p class="leading-7">{text(p)}</p>)}
        {images(s).map(asset=><img src={assetHref(`/assets/${text(asset.local_path)}`)} alt={text(asset.alt_text)} width={asset.width ? Number(asset.width):undefined} height={asset.height ? Number(asset.height):undefined} loading={s.type==='hero'?'eager':'lazy'} class="max-w-full rounded-lg" />)}
        {s.type==='faq' ? array(s.items).map(object).map(item=><details class="border-t border-border py-4"><summary>{text(item.question)}</summary><p class="mt-3">{text(item.answer)}</p></details>) : s.items && <ul class="grid gap-5 sm:grid-cols-2">{array(s.items).map(object).map(item=><li class="rounded-lg border border-border p-5"><h3 class="text-xl font-semibold">{text(item.title ?? item.value)}</h3><p class="mt-3">{text(item.description ?? item.label)}</p></li>)}</ul>}
        {array(s.actions ?? []).map(object).map(action=><a class="inline-flex rounded-md bg-primary px-5 py-3 text-primary-foreground" href={text(action.href)}>{text(action.label)}</a>)}
        {s.type==='cta' && <a class="inline-flex rounded-md bg-primary px-5 py-3 text-primary-foreground" href={ctaHref(s)}>{text(s.action_label)}</a>}
      </section>
    ))}
    {input.factsLink && <nav><a class="underline" href={input.factsLink.href}>{input.factsLink.label}</a></nav>}
    {manifest.disclosure_mode==='contextrocket' && <ContextRocketBadge variant="inline" tone={siteConfig.chrome.poweredByTone} />}
  </main>
</BaseLayout>
