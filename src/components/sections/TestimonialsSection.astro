---
import type { Testimonial } from "@/lib/testimonials";
import { createT } from "@/i18n/keys";
import type { SupportedLocale } from "@/i18n/locales";

interface Props {
  locale: SupportedLocale;
  title: string;
  items: Testimonial[];
}

const { locale, title, items } = Astro.props;
const t = createT(locale);
const visibleItems = items.filter((item) => item.quote.trim());
const initials = (name: string) =>
  name
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("")
    .toUpperCase();
---

{visibleItems.length > 0 && (
  <section
    class="px-5 py-16 sm:px-8 sm:py-20"
    data-testimonial-carousel
    aria-labelledby="testimonials-title"
  >
    <div class="mx-auto max-w-[868px]">
      <p class="mb-3 text-center text-xs font-semibold uppercase tracking-[0.18em] text-text-secondary">
        {t("testimonials.exampleLabel")}
      </p>
      <h2
        id="testimonials-title"
        class="text-center text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
      >
        {title}
      </h2>

      <div class="mt-8">
        {visibleItems.map((item, index) => (
          <figure
            class="grid min-h-[300px] grid-cols-1 items-center gap-6 rounded-2xl bg-secondary p-6 text-secondary-foreground shadow-sm sm:grid-cols-[120px_minmax(0,1fr)] sm:gap-8 sm:px-10 sm:py-9"
            data-testimonial-slide
            aria-hidden={index === 0 ? "false" : "true"}
            hidden={index !== 0}
          >
            {item.avatar ? (
              <img
                src={item.avatar}
                alt=""
                width="120"
                height="120"
                loading="lazy"
                class="mx-auto h-24 w-24 rounded-full object-cover sm:h-[120px] sm:w-[120px]"
              />
            ) : (
              <span
                aria-hidden="true"
                class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-secondary-foreground/10 text-xl font-semibold sm:h-[120px] sm:w-[120px]"
              >
                {initials(item.author)}
              </span>
            )}
            <div class="text-center sm:text-left">
              <blockquote class="text-lg leading-7 sm:text-xl sm:leading-8">
                &ldquo;{item.quote}&rdquo;
              </blockquote>
              <figcaption class="mt-6">
                <span class="block text-base font-semibold">{item.author}</span>
                {(item.role || item.company) && (
                  <span class="mt-1 block text-sm leading-snug opacity-80">
                    {[item.role, item.company].filter(Boolean).join(", ")}
                  </span>
                )}
              </figcaption>
            </div>
          </figure>
        ))}
      </div>

      {visibleItems.length > 1 && (
        <div class="mt-6 flex items-center justify-center gap-4" role="group" aria-label={title}>
          <button
            type="button"
            data-testimonial-previous
            aria-label={t("testimonials.previous")}
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-card text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
            </svg>
          </button>
          <div class="flex items-center gap-2" role="group" aria-label={t("testimonials.chooseSlide")}>
            {visibleItems.map((_, index) => (
              <button
                type="button"
                data-testimonial-index={index}
                aria-label={t("testimonials.slideLabel", { current: index + 1, total: visibleItems.length })}
                aria-current={index === 0 ? "true" : undefined}
                class:list={[
                  "h-3 rounded-full transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
                  index === 0 ? "w-6 bg-primary" : "w-3 bg-text-tertiary hover:bg-primary/70",
                ]}
              />
            ))}
          </div>
          <button
            type="button"
            data-testimonial-next
            aria-label={t("testimonials.next")}
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-card text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
            </svg>
          </button>
          <span class="sr-only" data-testimonial-status aria-live="polite">
            {t("testimonials.slideLabel", { current: 1, total: visibleItems.length })}
          </span>
        </div>
      )}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-testimonial-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-testimonial-slide]"));
    const indicators = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-testimonial-index]"));
    const status = carousel.querySelector<HTMLElement>("[data-testimonial-status]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-testimonial-previous]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-testimonial-next]");
    if (slides.length < 2 || indicators.length !== slides.length || !status) return;

    let activeIndex = 0;
    const activate = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        slide.hidden = slideIndex !== activeIndex;
        slide.setAttribute("aria-hidden", String(slideIndex !== activeIndex));
      });
      indicators.forEach((button, buttonIndex) => {
        const active = buttonIndex === activeIndex;
        button.setAttribute("aria-current", String(active));
        button.classList.toggle("w-6", active);
        button.classList.toggle("bg-primary", active);
        button.classList.toggle("w-3", !active);
        button.classList.toggle("bg-text-tertiary", !active);
      });
      status.textContent = indicators[activeIndex]?.getAttribute("aria-label") ?? "";
    };

    previous?.addEventListener("click", () => activate(activeIndex - 1));
    next?.addEventListener("click", () => activate(activeIndex + 1));
    indicators.forEach((button, index) => button.addEventListener("click", () => activate(index)));
  });
</script>
