---
import type { LocaleOption } from "./navigation-types";

interface Props {
  locale: string;
  options: LocaleOption[];
  changeLanguageLabel: string;
}

const { locale, options, changeLanguageLabel } = Astro.props;
---

<details class="relative z-[70]">
  <summary
    aria-label={changeLanguageLabel}
    title={changeLanguageLabel}
    data-testid="locale-switcher"
    class="flex h-9 min-w-[3rem] cursor-pointer list-none select-none items-center gap-1 rounded px-2 text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3a15 15 0 0 1 0 18m0-18a15 15 0 0 0 0 18" />
    </svg>
    <span class="text-xs font-medium uppercase">{locale}</span>
  </summary>
  <nav
    aria-label={changeLanguageLabel}
    data-testid="locale-switcher-menu"
    class="absolute right-0 top-[calc(100%+4px)] z-[9999] w-40 rounded border border-border bg-card py-1 shadow-lg"
  >
    <ul>
      {options.map((option) => (
        <li>
          <a
            href={option.href}
            aria-current={option.code === locale ? "page" : undefined}
            data-testid={`locale-switcher-option-${option.code}`}
            class:list={[
              "block w-full px-4 py-2 text-left text-sm text-foreground transition-colors hover:bg-foreground/5 focus-visible:outline-none focus-visible:bg-foreground/5",
              option.code === locale && "font-medium text-primary",
            ]}
          >
            {option.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</details>
