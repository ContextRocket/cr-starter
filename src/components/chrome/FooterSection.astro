---
/**
 * Footer — Astro port of the previous shared FooterSection.
 */
import ContextRocketBadge from "@/components/chrome/ContextRocketBadge.astro";

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  links: FooterLink[];
  companyName: string;
  variant?: "full" | "minimal";
  className?: string;
  containerClassName?: string;
  showPoweredByBadge?: boolean;
}

const {
  links,
  companyName,
  variant = "full",
  className = "",
  showPoweredByBadge = true,
  containerClassName = "max-w-screen-md px-4 sm:px-6",
} = Astro.props;
const year = new Date().getFullYear();
---

{
  variant === "minimal" ? (
    <footer
      class={`mt-auto border-t border-border bg-background text-muted-foreground ${className}`}
    >
      <div
        class={`mx-auto flex flex-col items-center justify-between gap-3 py-6 text-sm sm:flex-row ${containerClassName}`}
      >
        <span>
          &copy; {`${year} ${companyName}`}
        </span>
        {links.length > 0 && (
          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
            {links.map((link) => (
              <a
                href={link.href}
                class="transition-colors hover:text-foreground"
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </footer>
  ) : (
    <footer
      class={`mt-auto border-t border-border bg-background text-muted-foreground ${className}`}
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="py-6 text-center text-sm text-muted-foreground">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-center sm:gap-0">
            <span>
              &copy; {`${year} ${companyName}`}
            </span>
            <span class="mx-2 hidden sm:inline">-</span>
            <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
              {links.map((link, index) => (
                <span class="flex items-center gap-x-2">
                  <a
                    href={link.href}
                    class="underline transition-colors hover:text-primary"
                  >
                    {link.label}
                  </a>
                  {index < links.length - 1 && (
                    <span class="text-muted-foreground/60" aria-hidden="true">
                      |
                    </span>
                  )}
                </span>
              ))}
            </div>
          </div>
          {showPoweredByBadge !== false && (
            <div class="mt-6">
              <ContextRocketBadge />
            </div>
          )}
        </div>
      </div>
    </footer>
  )
}
