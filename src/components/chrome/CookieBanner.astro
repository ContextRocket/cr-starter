---
/** Optional consent controls for analytics, marketing, and custom integrations. */
import { siteConfig } from "@/config/site.config";
import { createT } from "@/i18n/keys";
import type { SupportedLocale } from "@/i18n/locales";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = createT(locale);
const enabled =
  siteConfig.features.cookieConsent === "on" &&
  siteConfig.integrationConsentMode === "auto";
const copy = siteConfig.features.cookieConsentCopy;
const preferencesDescription =
  copy?.preferencesDescription ?? t("cookie.consent.prefs.description");
const categories = ["functional", "analytics", "marketing"] as const;
const bannerStyle = siteConfig.chrome.cookieBannerStyle;
const terminal = bannerStyle === "terminal";
---

{
  enabled && (
    <section
      id="cr-cookie-banner"
      data-style={bannerStyle}
      class:list={[
        "fixed z-[2147483647] hidden p-4",
        bannerStyle === "bar" && "inset-x-0 bottom-0 border-t border-border bg-background/95 shadow-lg backdrop-blur",
        bannerStyle === "card" && "inset-x-3 bottom-3 max-h-[min(80vh,48rem)] overflow-y-auto rounded-2xl border border-border bg-card shadow-2xl sm:inset-x-auto sm:right-5 sm:w-[min(32rem,calc(100vw-2.5rem))]",
        bannerStyle === "terminal" && "inset-x-0 bottom-0 border-t border-foreground bg-foreground font-mono text-background shadow-2xl",
      ]}
      role="dialog"
      aria-modal="false"
      aria-labelledby="cr-cookie-title"
    >
      <div class="mx-auto max-w-5xl">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 id="cr-cookie-title" class:list={["text-base font-semibold", terminal ? "text-background" : "text-foreground"]}>
              {copy?.title ?? t("cookie.consent.title")}
            </h2>
            <p class:list={["mt-1 max-w-3xl text-sm leading-6", terminal ? "text-background/75" : "text-text-secondary"]}>
              {copy?.body ?? t("cookie.consent.body")}
            </p>
          </div>
          <button
            type="button"
            data-action="manage"
            aria-expanded="false"
            aria-controls="cr-cookie-settings"
            class:list={[
              "min-h-10 shrink-0 rounded-lg border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
              terminal ? "border-background/25 text-background hover:bg-background/10" : "border-border text-foreground hover:bg-muted",
            ]}
          >
            {copy?.manage ?? t("cookie.consent.manage")}
          </button>
        </div>

        <div id="cr-cookie-settings" class="mt-4 space-y-4" hidden>
          {preferencesDescription && (
            <p class:list={["text-sm leading-6", terminal ? "text-background/75" : "text-text-secondary"]}>
              {preferencesDescription}
            </p>
          )}
          <div class="grid gap-2 sm:grid-cols-2">
            <label class:list={["flex items-start gap-3 rounded-lg border p-3", terminal ? "border-background/15" : "border-border"]}>
              <input
                type="checkbox"
                name="necessary"
                checked
                disabled
                class="mt-1 size-4 shrink-0 accent-primary"
              />
              <span>
                <span class:list={["block text-sm font-medium", terminal ? "text-background" : "text-foreground"]}>
                  {copy?.categories?.necessary?.label ?? t("cookie.consent.prefs.category.necessary.label")}
                  {copy?.categories?.necessary?.alwaysActiveLabel && (
                    <> {copy.categories.necessary.alwaysActiveLabel}</>
                  )}
                </span>
                <span class:list={["mt-1 block text-xs leading-5", terminal ? "text-background/75" : "text-text-secondary"]}>
                  {copy?.categories?.necessary?.description ?? t("cookie.consent.prefs.category.necessary.description")}
                </span>
              </span>
            </label>
            {categories.map((category) => (
              <label class:list={["flex items-start gap-3 rounded-lg border p-3", terminal ? "border-background/15" : "border-border"]}>
                <input
                  type="checkbox"
                  name={category}
                  class="mt-1 size-4 shrink-0 accent-primary"
                />
                <span>
                  <span class:list={["block text-sm font-medium", terminal ? "text-background" : "text-foreground"]}>
                    {copy?.categories?.[category]?.label ?? t(`cookie.consent.prefs.category.${category}.label`)}
                  </span>
                  <span class:list={["mt-1 block text-xs leading-5", terminal ? "text-background/75" : "text-text-secondary"]}>
                    {copy?.categories?.[category]?.description ?? t(`cookie.consent.prefs.category.${category}.description`)}
                  </span>
                </span>
              </label>
            ))}
          </div>
        </div>

        <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
          <button
            type="button"
            data-consent="deny"
            class:list={[
              "min-h-10 rounded-lg border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
              terminal ? "border-background/25 text-background hover:bg-background/10" : "border-border text-foreground hover:bg-muted",
            ]}
          >
            {copy?.decline ?? t("cookie.consent.decline")}
          </button>
          <button
            type="button"
            data-action="save"
            class:list={[
              "min-h-10 hidden rounded-lg border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
              terminal ? "border-background/25 text-background hover:bg-background/10" : "border-border text-foreground hover:bg-muted",
            ]}
          >
            {copy?.save ?? t("cookie.consent.prefs.save")}
          </button>
          <button
            type="button"
            data-consent="accept"
            class="min-h-10 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {copy?.accept ?? t("cookie.consent.accept")}
          </button>
        </div>
      </div>
    </section>
  )
}
