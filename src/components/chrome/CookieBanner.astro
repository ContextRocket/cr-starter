---
/** Optional consent controls for analytics, marketing, and custom integrations. */
import { siteConfig } from "@/config/site.config";
import { createT } from "@/i18n/keys";
import type { SupportedLocale } from "@/i18n/locales";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = createT(locale);
const enabled =
  siteConfig.features.cookieConsent === "on" &&
  siteConfig.integrationConsentMode === "auto";
const categories = ["functional", "analytics", "marketing"] as const;
---

{
  enabled && (
    <section
      id="cr-cookie-banner"
      class="fixed inset-x-0 bottom-0 z-[60] hidden border-t border-border bg-background/95 p-4 shadow-lg backdrop-blur"
      role="dialog"
      aria-modal="false"
      aria-labelledby="cr-cookie-title"
    >
      <div class="mx-auto max-w-5xl">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 id="cr-cookie-title" class="text-base font-semibold text-foreground">
              {t("cookie.consent.title")}
            </h2>
            <p class="mt-1 max-w-3xl text-sm leading-6 text-text-secondary">
              {t("cookie.consent.body")}
            </p>
          </div>
          <button
            type="button"
            data-action="manage"
            aria-expanded="false"
            aria-controls="cr-cookie-settings"
            class="min-h-10 shrink-0 rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {t("cookie.consent.manage")}
          </button>
        </div>

        <div id="cr-cookie-settings" class="mt-4 space-y-4" hidden>
          <p class="text-sm leading-6 text-text-secondary">
            {t("cookie.consent.prefs.description")}
          </p>
          <div class="grid gap-2 sm:grid-cols-2">
            <label class="flex items-start gap-3 rounded-lg border border-border p-3">
              <input
                type="checkbox"
                name="necessary"
                checked
                disabled
                class="mt-1 size-4 shrink-0 accent-primary"
              />
              <span>
                <span class="block text-sm font-medium text-foreground">
                  {t("cookie.consent.prefs.category.necessary.label")}
                </span>
                <span class="mt-1 block text-xs leading-5 text-text-secondary">
                  {t("cookie.consent.prefs.category.necessary.description")}
                </span>
              </span>
            </label>
            {categories.map((category) => (
              <label class="flex items-start gap-3 rounded-lg border border-border p-3">
                <input
                  type="checkbox"
                  name={category}
                  class="mt-1 size-4 shrink-0 accent-primary"
                />
                <span>
                  <span class="block text-sm font-medium text-foreground">
                    {t(`cookie.consent.prefs.category.${category}.label`)}
                  </span>
                  <span class="mt-1 block text-xs leading-5 text-text-secondary">
                    {t(`cookie.consent.prefs.category.${category}.description`)}
                  </span>
                </span>
              </label>
            ))}
          </div>
        </div>

        <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
          <button
            type="button"
            data-consent="deny"
            class="min-h-10 rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {t("cookie.consent.decline")}
          </button>
          <button
            type="button"
            data-action="save"
            class="min-h-10 hidden rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {t("cookie.consent.prefs.save")}
          </button>
          <button
            type="button"
            data-consent="accept"
            class="min-h-10 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {t("cookie.consent.accept")}
          </button>
        </div>
      </div>
    </section>
  )
}

{
  enabled && (
    <script is:inline>
      (() => {
        const STORAGE_KEY = "cr_cookie_consent";
        const CONSENT_EVENT = "cr:consent-change";
        const OPEN_SETTINGS_EVENT = "cr:open-cookie-settings";
        const banner = document.getElementById("cr-cookie-banner");
        if (!banner) return;

        const settings = document.getElementById("cr-cookie-settings");
        const manageButton = banner.querySelector('[data-action="manage"]');
        const saveButton = banner.querySelector('[data-action="save"]');
        const denyButton = banner.querySelector('[data-consent="deny"]');
        const acceptButton = banner.querySelector('[data-consent="accept"]');

        const emptyPreferences = () => ({
          necessary: true,
          functional: false,
          analytics: false,
          marketing: false,
        });

        function readPreferences() {
          try {
            const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
            if (stored?.version === 2 && stored.preferences) {
              return {
                necessary: true,
                functional: stored.preferences.functional === true,
                analytics: stored.preferences.analytics === true,
                marketing: stored.preferences.marketing === true,
              };
            }
            if (stored?.version === 1 && stored.choice) {
              const accepted = stored.choice === "accept";
              return {
                necessary: true,
                functional: accepted,
                analytics: accepted,
                marketing: accepted,
              };
            }
          } catch {
            // Keep the banner visible when browser storage is unavailable.
          }
          return null;
        }

        function updateCheckboxes(preferences) {
          ["functional", "analytics", "marketing"].forEach((category) => {
            const checkbox = banner.querySelector(`[name="${category}"]`);
            if (checkbox) checkbox.checked = preferences[category] === true;
          });
        }

        function setSettingsOpen(open) {
          if (!settings) return;
          settings.hidden = !open;
          manageButton?.setAttribute("aria-expanded", String(open));
          denyButton?.classList.toggle("hidden", open);
          acceptButton?.classList.toggle("hidden", open);
          saveButton?.classList.toggle("hidden", !open);
          if (open && !settings.hidden) {
            settings.querySelector("input:not(:disabled)")?.focus();
          }
        }

        function emitConsent(preferences) {
          window.dispatchEvent(
            new CustomEvent(CONSENT_EVENT, {
              detail: { version: 2, preferences },
            }),
          );
        }

        function save(preferences, choice) {
          try {
            localStorage.setItem(
              STORAGE_KEY,
              JSON.stringify({
                version: 2,
                choice,
                preferences,
                at: new Date().toISOString(),
              }),
            );
          } catch {
            // Consent still applies for this page view if storage is blocked.
          }
          emitConsent(preferences);
          banner.classList.add("hidden");
          setSettingsOpen(false);
        }

        function openSettings(edit = true) {
          updateCheckboxes(readPreferences() || emptyPreferences());
          banner.classList.remove("hidden");
          setSettingsOpen(edit);
        }

        const saved = readPreferences();
        if (saved) updateCheckboxes(saved);
        else banner.classList.remove("hidden");

        manageButton?.addEventListener("click", () => {
          const isOpen = manageButton.getAttribute("aria-expanded") === "true";
          openSettings(!isOpen);
        });

        denyButton?.addEventListener("click", () => {
          save(emptyPreferences(), "deny");
        });

        acceptButton?.addEventListener("click", () => {
          save(
            { necessary: true, functional: true, analytics: true, marketing: true },
            "accept",
          );
        });

        saveButton?.addEventListener("click", () => {
          const preferences = emptyPreferences();
          ["functional", "analytics", "marketing"].forEach((category) => {
            const checkbox = banner.querySelector(`[name="${category}"]`);
            preferences[category] = checkbox?.checked === true;
          });
          save(preferences, "custom");
        });

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest("[data-open-cookie-settings]")) {
            event.preventDefault();
            openSettings(true);
          }
        });

        window.addEventListener(OPEN_SETTINGS_EVENT, () => openSettings(true));
      })();
    </script>
  )
}
