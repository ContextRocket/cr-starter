---
import BrandLogo from "@/components/chrome/BrandLogo.astro";
import type { BrandLogoAsset } from "./brand-logo-types";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import type { LocaleOption, NavLink } from "./navigation-types";

interface Props {
  links: NavLink[];
  logo?: BrandLogoAsset;
  brandName?: string;
  homeHref?: string;
  navLabel: string;
  openMenuLabel: string;
  closeMenuLabel: string;
  showLanguageSelector?: boolean;
  locale?: string;
  localeOptions?: LocaleOption[];
  changeLanguageLabel: string;
  navBreakpoint?: "lg" | "xl";
  className?: string;
}

const {
  links,
  logo,
  brandName = "",
  homeHref = "/",
  navLabel,
  openMenuLabel,
  closeMenuLabel,
  showLanguageSelector = true,
  locale = "en",
  localeOptions = [],
  changeLanguageLabel,
  navBreakpoint = "lg",
  className = "",
} = Astro.props;
const showLocale = showLanguageSelector && localeOptions.length > 1;
const desktopBreakpoint = navBreakpoint === "xl" ? "xl" : "lg";
const menuMediaQuery =
  desktopBreakpoint === "xl" ? "(min-width: 1280px)" : "(min-width: 1024px)";

---

<header
  class={`relative z-50 w-full overflow-visible bg-background text-foreground shadow-sm ${className}`}
>
  <nav
    aria-label={navLabel}
    class="mx-auto flex h-16 max-w-screen-xl items-center justify-between px-4 sm:px-8"
  >
    <a href={homeHref} class="flex shrink-0 items-center">
      {logo ? <BrandLogo logo={logo} brandName={brandName} /> : brandName}
    </a>

    <div
      class:list={[
        "hidden items-center gap-[clamp(1.25rem,2vw,2rem)]",
        desktopBreakpoint === "xl" ? "xl:flex" : "lg:flex",
      ]}
    >
      {links.map((link) =>
        link.variant === "primary" ? (
          <a
            href={link.href}
            aria-current={link.current ? "page" : undefined}
            class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
          >
            {link.label}
          </a>
        ) : (
          <a
            href={link.href}
            aria-current={link.current ? "page" : undefined}
            class:list={[
              "text-sm transition-colors hover:text-foreground",
              link.current
                ? "font-medium text-foreground"
                : "text-muted-foreground",
            ]}
          >
            {link.label}
          </a>
        ),
      )}
      {showLocale && (
        <LocaleSwitcher
          locale={locale}
          options={localeOptions}
          changeLanguageLabel={changeLanguageLabel}
        />
      )}
    </div>

    <div
      class:list={[
        "flex items-center gap-1",
        desktopBreakpoint === "xl" ? "xl:hidden" : "lg:hidden",
      ]}
    >
      {showLocale && (
        <LocaleSwitcher
          locale={locale}
          options={localeOptions}
          changeLanguageLabel={changeLanguageLabel}
        />
      )}
      <button
        type="button"
        data-mobile-nav-open
        aria-label={openMenuLabel}
        aria-expanded="false"
        aria-controls="mobile-navigation-panel"
        class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </nav>

  <dialog
    id="mobile-navigation-panel"
    aria-label={navLabel}
    data-desktop-query={menuMediaQuery}
    class="mobile-navigation fixed inset-y-0 right-0 m-0 h-dvh max-h-none w-full overflow-y-auto max-w-none border-0 bg-background px-6 py-6 text-foreground shadow-2xl backdrop:bg-foreground/40 sm:max-w-sm"
  >
    <div class="flex items-center justify-between">
      <a href={homeHref} class="-m-1.5 p-1.5">
        {logo ? <BrandLogo logo={logo} brandName={brandName} /> : brandName}
      </a>
      <button
        type="button"
        data-mobile-nav-close
        aria-label={closeMenuLabel}
        class="-m-2.5 rounded-md p-2.5 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <div class="mt-8 flow-root">
      <div class="space-y-2">
        {links.map((link) =>
          link.variant === "primary" ? (
            <a
              href={link.href}
              aria-current={link.current ? "page" : undefined}
              class="mt-4 block w-full rounded-lg bg-primary px-4 py-3 text-center text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
            >
              {link.label}
            </a>
          ) : (
            <a
              href={link.href}
              aria-current={link.current ? "page" : undefined}
              class:list={[
                "block rounded-lg px-4 py-3 text-base font-semibold hover:bg-muted hover:text-foreground",
                link.current
                  ? "bg-muted text-foreground"
                  : "text-muted-foreground",
              ]}
            >
              {link.label}
            </a>
          ),
        )}
      </div>
    </div>
  </dialog>
</header>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    "#mobile-navigation-panel",
  );
  const openButton = document.querySelector<HTMLButtonElement>(
    "[data-mobile-nav-open]",
  );
  const closeButton = document.querySelector<HTMLButtonElement>(
    "[data-mobile-nav-close]",
  );

  if (dialog && openButton) {
    openButton.addEventListener("click", () => dialog.showModal());
    dialog.addEventListener("close", () => {
      openButton.setAttribute("aria-expanded", "false");
    });
    dialog.addEventListener("cancel", () => {
      openButton.setAttribute("aria-expanded", "false");
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) dialog.close();
    });
    dialog.addEventListener("close", () => {
      openButton.focus({ preventScroll: true });
    });
    closeButton?.addEventListener("click", () => dialog.close());
    openButton.addEventListener("click", () => {
      openButton.setAttribute("aria-expanded", "true");
    });
    const desktopQuery = dialog.dataset.desktopQuery ?? "(min-width: 1024px)";
    window.matchMedia(desktopQuery).addEventListener("change", (event) => {
      if (event.matches && dialog.open) dialog.close();
    });
  }
</script>

<style>
  .mobile-navigation[open] {
    animation: mobile-navigation-enter 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes mobile-navigation-enter {
    from {
      transform: translateX(100%);
    }

    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-navigation[open] {
      animation: none;
    }
  }
</style>
