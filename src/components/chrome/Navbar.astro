---
import BrandLogo from "@/components/chrome/BrandLogo.astro";
import type { BrandLogoAsset } from "./brand-logo-types";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import type { LocaleOption, NavLink } from "./navigation-types";

interface Props {
  links: NavLink[];
  logo?: BrandLogoAsset;
  brandName?: string;
  homeHref?: string;
  navLabel: string;
  openMenuLabel: string;
  closeMenuLabel: string;
  showLanguageSelector?: boolean;
  locale?: string;
  localeOptions?: LocaleOption[];
  changeLanguageLabel: string;
  navBreakpoint?: "lg" | "xl";
  containerClassName?: string;
  className?: string;
}

const {
  links,
  logo,
  brandName = "",
  homeHref = "/",
  navLabel,
  openMenuLabel,
  closeMenuLabel,
  showLanguageSelector = true,
  locale = "en",
  localeOptions = [],
  changeLanguageLabel,
  navBreakpoint = "lg",
  containerClassName = "max-w-screen-xl",
  className = "",
} = Astro.props;
const showLocale = showLanguageSelector && localeOptions.length > 1;
const desktopBreakpoint = navBreakpoint === "xl" ? "xl" : "lg";
---

<header
  class={`relative z-50 w-full overflow-visible border-b border-[var(--nav-line,var(--border))] bg-[var(--nav-surface,var(--background))] text-[var(--nav-ink,var(--foreground))] shadow-sm ${className}`}
>
  <nav
    aria-label={navLabel}
    class:list={["mx-auto flex h-16 items-center justify-between px-4 sm:px-8", containerClassName]}
  >
    <a href={homeHref} class="flex shrink-0 items-center">
      {logo ? <BrandLogo logo={logo} brandName={brandName} /> : brandName}
    </a>

    <div
      class:list={[
        "hidden items-center gap-[clamp(1.25rem,2vw,2rem)]",
        desktopBreakpoint === "xl" ? "xl:flex" : "lg:flex",
      ]}
    >
      {links.map((link) =>
        link.variant === "primary" ? (
          <a
            href={link.href}
            aria-current={link.current ? "page" : undefined}
            class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
          >
            {link.label}
          </a>
        ) : (
          <a
            href={link.href}
            aria-current={link.current ? "page" : undefined}
            class:list={[
              "text-sm transition-colors hover:text-[var(--nav-ink,var(--foreground))]",
              link.current
                ? "font-medium text-[var(--nav-ink,var(--foreground))]"
                : "text-[var(--nav-muted,var(--muted-foreground))]",
            ]}
          >
            {link.label}
          </a>
        ),
      )}
      {showLocale && (
        <LocaleSwitcher
          locale={locale}
          options={localeOptions}
          changeLanguageLabel={changeLanguageLabel}
        />
      )}
    </div>

    <div
      class:list={[
        "flex items-center gap-1 text-[var(--nav-muted,var(--muted-foreground))]",
        desktopBreakpoint === "xl" ? "xl:hidden" : "lg:hidden",
      ]}
    >
      {showLocale && (
        <LocaleSwitcher
          locale={locale}
          options={localeOptions}
          changeLanguageLabel={changeLanguageLabel}
        />
      )}
      <details class="group relative">
        <summary class="-m-2.5 inline-flex size-11 cursor-pointer list-none items-center justify-center rounded-md p-2.5 transition-colors hover:text-[var(--nav-ink,var(--foreground))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="size-6 group-open:hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="hidden size-6 group-open:block">
            <path stroke-linecap="round" stroke-linejoin="round" d="m6 6 12 12M18 6 6 18" />
          </svg>
          <span class="sr-only group-open:hidden">{openMenuLabel}</span>
          <span class="sr-only hidden group-open:inline">{closeMenuLabel}</span>
        </summary>
        <div class="fixed inset-x-0 top-16 z-[60] max-h-[calc(100dvh-4rem)] overflow-y-auto border-y border-[var(--nav-line,var(--border))] bg-[var(--nav-surface,var(--background))] px-4 py-4 text-[var(--nav-ink,var(--foreground))] shadow-xl sm:absolute sm:inset-x-auto sm:right-0 sm:mt-2 sm:max-h-[calc(100dvh-5rem)] sm:w-96 sm:rounded-xl sm:border sm:p-3">
          <nav aria-label={navLabel} class="flex flex-col gap-1">
            {links.map((link) =>
              link.variant === "primary" ? (
                <a
                  href={link.href}
                  aria-current={link.current ? "page" : undefined}
                  class="mt-2 block w-full rounded-lg bg-primary px-4 py-3 text-center text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
                >
                  {link.label}
                </a>
              ) : (
                <a
                  href={link.href}
                  aria-current={link.current ? "page" : undefined}
                  class:list={[
                    "block rounded-lg px-4 py-3 text-base font-semibold transition-colors hover:bg-muted hover:text-[var(--nav-ink,var(--foreground))]",
                    link.current
                      ? "bg-muted text-[var(--nav-ink,var(--foreground))]"
                      : "text-[var(--nav-muted,var(--muted-foreground))]",
                  ]}
                >
                  {link.label}
                </a>
              ),
            )}
          </nav>
        </div>
      </details>
    </div>
  </nav>

</header>
