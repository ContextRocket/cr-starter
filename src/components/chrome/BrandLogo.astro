---
import type { BrandLogoAsset } from "./brand-logo-types";

interface Props {
  logo: BrandLogoAsset;
  brandName?: string;
  className?: string;
}

const { logo, brandName = "", className } = Astro.props;
const variant = logo.variant ?? "icon";
---

{variant === "wordmark" ? (
  <span class="inline-flex items-center">
    <img
      src={logo.src}
      alt={logo.alt}
      width={logo.width}
      height={logo.height}
      class={className ?? "block shrink-0"}
      style={className ? undefined : `width:${logo.width}px;height:${logo.height}px`}
    />
  </span>
) : (
  <span class="inline-flex items-center gap-2">
    <img
      src={logo.src}
      alt={logo.alt}
      width={logo.width}
      height={logo.height}
      class={className ?? "block shrink-0"}
      style={className ? undefined : `width:${logo.width}px;height:${logo.height}px`}
    />
    {brandName && (
      <span class="text-lg font-semibold tracking-tight text-foreground">
        {brandName}
      </span>
    )}
  </span>
)}
