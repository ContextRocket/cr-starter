---
import { createT } from "@/i18n/keys";
import type { SupportedLocale } from "@/i18n/locales";
import { siteConfig } from "@/config/site.config";

interface Props {
  variant?: "stacked" | "inline" | "logo";
  tone?: "ink" | "white";
  className?: string;
}

const {
  variant = "stacked",
  tone = "ink",
  className = "",
} = Astro.props;
const locale = (Astro.currentLocale ?? "en") as SupportedLocale;
const t = createT(locale);
const logo = tone === "white"
  ? `${siteConfig.contextRocketBrandAssetsUrl}/logo-h-spark-white.svg`
  : `${siteConfig.contextRocketBrandAssetsUrl}/logo-h-spark-ink.svg`;
---

<a
  href="https://contextrocket.com"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${t("attribution.poweredBy")} ContextRocket`}
  class:list={[
    "powered-by group inline-flex items-center",
    `powered-by-${variant}`,
    `powered-by-${tone}`,
    className,
  ]}
  data-testid="powered-by-badge"
>
  {variant !== "logo" && <span class="powered-by-label">{t("attribution.poweredBy")}</span>}
  <img src={logo} alt="ContextRocket" width="149" height="20" decoding="async" />
</a>

<style is:global>
  .powered-by { gap: .5rem; color: var(--muted-foreground); text-decoration: none; transition: opacity 160ms ease; }
  .powered-by:hover { opacity: .72; }
  .powered-by img { display: block; width: auto; height: 1.25rem; }
  .powered-by-label { font-size: .625rem; font-weight: 550; line-height: 1; letter-spacing: .16em; text-transform: uppercase; }
  .powered-by-stacked { flex-direction: column; gap: .35rem; }
  .powered-by-inline { flex-direction: row; }
  .powered-by-logo img { height: 1.25rem; }
  .powered-by-white .powered-by-label { color: rgb(255 255 255 / .65); }
  .powered-by-white img { filter: none; }
  @media (prefers-reduced-motion: reduce) { .powered-by { transition: none; } }
</style>
