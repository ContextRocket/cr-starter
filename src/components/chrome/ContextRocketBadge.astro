---
import PoweredBy from "./PoweredBy.astro";

interface Props {
  className?: string;
  variant?: "stacked" | "inline" | "logo";
  tone?: "ink" | "white";
}

const { className = "", variant = "stacked", tone = "ink" } = Astro.props;
---

<PoweredBy className={className} variant={variant} tone={tone} />
