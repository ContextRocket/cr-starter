---
/** Compact header emitted as static HTML during the Astro build. */
import BrandLogo from "@/components/chrome/BrandLogo.astro";
import type { BrandLogoAsset } from "@/components/chrome/brand-logo-types";
import type { LocaleOption, NavLink } from "@/components/chrome/navigation-types";

interface Props {
  links: NavLink[];
  logo?: BrandLogoAsset;
  brandName: string;
  homeHref?: string;
  navLabel: string;
  openMenuLabel?: string;
  closeMenuLabel?: string;
  showLanguageSelector?: boolean;
  locale?: string;
  localeOptions?: LocaleOption[];
  changeLanguageLabel: string;
  className?: string;
  containerClassName?: string;
}

const {
  links,
  logo,
  brandName,
  homeHref = "/",
  navLabel,
  showLanguageSelector = true,
  locale = "en",
  localeOptions = [],
  changeLanguageLabel,
  className = "",
  containerClassName = "max-w-screen-md px-4 sm:px-6",
} = Astro.props;
const showLocale = showLanguageSelector && localeOptions.length > 1;
---

<header class={`w-full border-b border-[var(--nav-line,var(--border))] bg-[var(--nav-surface,var(--background))] text-[var(--nav-ink,var(--foreground))] ${className}`}>
  <nav
    aria-label={navLabel}
    class={`mx-auto flex min-h-14 w-full flex-wrap items-center justify-between gap-y-2 py-2 ${containerClassName}`}
  >
    <a
      href={homeHref}
      class="shrink-0 text-base font-semibold tracking-tight transition-colors hover:text-[var(--nav-ink,var(--foreground))]"
    >
      {logo ? <BrandLogo logo={logo} brandName={brandName} /> : brandName}
    </a>

    {(links.length > 0 || showLocale) && (
      <div class="flex min-w-0 items-center gap-2 sm:gap-6">
        {links.map((link) => (
          link.variant === "primary" ? (
            <a
              href={link.href}
              aria-current={link.current ? "page" : undefined}
              class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
            >
              {link.label}
            </a>
          ) : (
            <a
              href={link.href}
              aria-current={link.current ? "page" : undefined}
              class:list={[
                "text-sm transition-colors hover:text-[var(--nav-ink,var(--foreground))]",
                link.current ? "font-medium text-[var(--nav-ink,var(--foreground))]" : "text-[var(--nav-muted,var(--muted-foreground))]",
              ]}
            >
              {link.label}
            </a>
          )
        ))}

        {showLocale && (
          <details class="relative z-[70]">
            <summary
              aria-label={changeLanguageLabel}
              title={changeLanguageLabel}
              class="flex h-9 min-w-[3rem] cursor-pointer list-none select-none items-center gap-1 rounded px-2 text-sm text-[var(--nav-muted,var(--muted-foreground))] transition-colors hover:text-[var(--nav-ink,var(--foreground))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3a15 15 0 0 1 0 18m0-18a15 15 0 0 0 0 18" />
              </svg>
              <span class="text-xs font-medium uppercase">{locale}</span>
            </summary>
            <nav
              aria-label={changeLanguageLabel}
              class="absolute right-0 top-[calc(100%+4px)] z-[9999] w-40 rounded border border-border bg-card py-1 shadow-lg"
            >
              <ul>
                {localeOptions.map((option) => (
                  <li>
                    <a
                      href={option.href}
                      aria-current={option.code === locale ? "page" : undefined}
                      class:list={[
                        "block w-full px-4 py-2 text-left text-sm text-foreground transition-colors hover:bg-foreground/5 focus-visible:outline-none focus-visible:bg-foreground/5",
                        { "font-medium text-primary": option.code === locale },
                      ]}
                    >
                      {option.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )}
      </div>
    )}
  </nav>
</header>
