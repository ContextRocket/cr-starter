---
import { siteConfig } from "@/config/site.config";

const integrations = siteConfig.integrations;
const activeIntegrations = Object.values(integrations).some(
  (integration) => integration.enabled !== false,
);
const consentManaged =
  siteConfig.integrationConsentMode === "external" ||
  (siteConfig.integrationConsentMode === "auto" &&
    siteConfig.features.cookieConsent === "on");
const payload = JSON.stringify({
  integrations,
  consentManaged,
  consentStorage: siteConfig.integrationConsentMode !== "external",
}).replaceAll("<", "\\u003c");
---

{
  activeIntegrations && (
    <>
      <script
        id="cr-site-integrations-config"
        type="application/json"
        is:inline
        set:html={payload}
      />
      <script>
        import { initializeSiteIntegrations } from "@/lib/integrations";

        const configNode = document.getElementById("cr-site-integrations-config");
        if (configNode?.textContent) {
          try {
            initializeSiteIntegrations(JSON.parse(configNode.textContent));
          } catch {
            console.error("ContextRocket site integration config is invalid.");
          }
        }
      </script>
    </>
  )
}
