---
import { siteConfig } from "@/config/site.config";

const integrations = siteConfig.integrations;
const activeIntegrations = Object.values(integrations).some(
  (integration) => integration.enabled !== false,
);
const consentBanner = siteConfig.consentBanner;
const shouldLoadSiteBehaviors = activeIntegrations || consentBanner;
const consentManaged = siteConfig.consentManaged;
const payload = JSON.stringify({
  integrations,
  consentManaged,
  consentStorage: siteConfig.integrationConsentMode !== "external",
  consentBanner,
}).replaceAll("<", "\\u003c");
const siteBehaviorsSrc =
  import.meta.env.PUBLIC_CONTEXTROCKET_SITE_BEHAVIORS_URL?.trim() ||
  "/embed/site-behaviors.js";
---

{
  shouldLoadSiteBehaviors && (
    <>
      <script
        id="cr-site-integrations-config"
        type="application/json"
        is:inline
        set:html={payload}
      />
      <script is:inline src={siteBehaviorsSrc} defer></script>
    </>
  )
}
