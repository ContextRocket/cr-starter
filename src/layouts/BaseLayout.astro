---
import { siteConfig, isSingleLocale } from "@/config/site.config";
import type { SupportedLocale } from "@/i18n/locales";
import SiteChrome from "@/components/chrome/SiteChrome.astro";
import CookieBanner from "@/components/chrome/CookieBanner.astro";
import SiteIntegrations from "@/components/chrome/SiteIntegrations.astro";
import {
  buildHomeJsonLd,
  serializeJsonLd,
  type JsonLdNode,
} from "@/lib/structured-data";
import { absoluteUrl } from "@/lib/paths";
import "../styles/global.css";

interface Props {
  title?: string;
  /** Use the supplied title verbatim when it is already a complete document title. */
  titleIsExact?: boolean;
  /** Override the default site-name suffix for this page. */
  titleSuffix?: string;
  description?: string;
  locale: SupportedLocale;
  path?: string;
  /** Absolute or site-relative image for Open Graph / Twitter cards. */
  image?: string;
  /** When true (default on home), emit Organization + WebSite JSON-LD. */
  includeSiteJsonLd?: boolean;
  /** Extra JSON-LD nodes merged after the optional home Organization/WebSite. */
  jsonLdExtra?: unknown[];
  ogType?: "website" | "article";
  robots?: "index, follow" | "noindex, follow";
}

const { locale, path = "/" } = Astro.props;
const pageTitle = Astro.props.title;
const titleSeparator = ` ${siteConfig.titleSeparator} `;
const configuredTitleSuffix = Astro.props.titleSuffix?.trim();
const titleSuffix = configuredTitleSuffix || siteConfig.companyName;
const title = Astro.props.titleIsExact && pageTitle
  ? pageTitle
  : pageTitle
  ? pageTitle === siteConfig.companyName && !configuredTitleSuffix
    ? pageTitle
    : `${pageTitle}${titleSeparator}${titleSuffix}`
  : path === "/" && siteConfig.homeMetaTitle
    ? siteConfig.homeMetaTitle
    : `${siteConfig.homeTitle || siteConfig.companyName}${titleSeparator}${siteConfig.tagline}`;
const description = Astro.props.description ?? (
  path === "/" && siteConfig.homeMetaDescription
    ? siteConfig.homeMetaDescription
    : siteConfig.description
);
const ogType = Astro.props.ogType ?? "website";
const robots = Astro.props.robots ?? "index, follow";
const includeSiteJsonLd = Astro.props.includeSiteJsonLd ?? path === "/";

const origin = siteConfig.siteUrl.replace(/\/$/, "");
const canonical = isSingleLocale()
  ? absoluteUrl(path)
  : absoluteUrl(`/${locale}${path.startsWith("/") ? path : `/${path}`}`);

const rawImage =
  Astro.props.image ||
  siteConfig.assets.icon512 ||
  siteConfig.assets.appleTouchIcon ||
  siteConfig.assets.logo ||
  "/favicon.ico";
const ogImage = rawImage.startsWith("http")
  ? rawImage
  : `${origin}${rawImage.startsWith("/") ? rawImage : `/${rawImage}`}`;

const twitterHandle = siteConfig.social.twitter?.replace(/^https?:\/\/(www\.)?(twitter|x)\.com\//, "@")
  || siteConfig.social.twitter;

const multiLocale = !isSingleLocale();
const hreflangLocales = multiLocale
  ? (siteConfig.locales as readonly string[])
  : [];
const defaultHreflangLocale = hreflangLocales.includes(siteConfig.defaultLocale)
  ? siteConfig.defaultLocale
  : (hreflangLocales[0] ?? siteConfig.defaultLocale);

function hreflangHref(forLocale: string): string {
  return absoluteUrl(`/${forLocale}${path.startsWith("/") ? path : `/${path}`}`);
}

const theme = siteConfig.theme;
const themeTokenMap = theme.tokens as Record<string, string> | undefined;
const configuredSans = themeTokenMap?.["--font-sans"];
const preloadInterTight =
  typeof configuredSans !== "string" || configuredSans.includes("Inter Tight");
const fontRoot = `${siteConfig.contextRocketBrandAssetsUrl}/fonts`;
const interTightFont = `${fontRoot}/InterTight-Variable.woff2`;
const newsreaderFont = `${fontRoot}/Newsreader-Italic.woff2`;
const geistMonoFont = `${fontRoot}/GeistMonoVF.woff`;
const fontFaceCss = `@font-face{font-family:"Inter Tight";src:url(${JSON.stringify(interTightFont)}) format("woff2");font-weight:100 900;font-display:swap}@font-face{font-family:"Newsreader";src:url(${JSON.stringify(newsreaderFont)}) format("woff2");font-style:italic;font-weight:400;font-display:swap}@font-face{font-family:"Geist Mono";src:url(${JSON.stringify(geistMonoFont)}) format("woff");font-weight:100 900;font-display:swap}`;
const themeEntries = Object.entries(theme.tokens ?? {}).filter(
  ([key, value]) => /^--[a-zA-Z0-9_-]+$/.test(key) &&
    typeof value === "string" && !/[<>;{}]/.test(value),
);
const radius = theme.radius ?? "0.5rem";
const themeColor = theme.tokens?.["--background"] as string | undefined;
const themeCss = `html:root{--radius:${radius};--font-sans:"Inter Tight",system-ui,sans-serif;--font-mono:"Geist Mono",ui-monospace,monospace;--font-editorial:"Newsreader",Georgia,serif;${themeEntries
  .map(([k, v]) => `${k}:${v}`)
  .join(";")}}`;

const showChat = siteConfig.features.chatFab;
const accent =
  (siteConfig.theme.tokens?.["--brand-accent"] as string | undefined) ||
  (siteConfig.theme.tokens?.["--primary"] as string | undefined) ||
  "#0E0F13";
const widgetColor = (name: string, fallback: string) =>
  ((siteConfig.theme.tokens as Record<string, string>)?.[name] as string | undefined) || fallback;
const attr = (value: string) =>
  value.replaceAll("&", "&amp;").replaceAll('"', "&quot;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
const widgetSnippet = showChat
  ? `<script src="${attr(siteConfig.chat.widgetSrc)}" defer data-contextrocket-handle="${attr(siteConfig.chat.handle)}" data-contextrocket-api-key="${attr(siteConfig.chat.apiKey)}" data-contextrocket-api-base="${attr(siteConfig.chat.agentUrl)}" data-contextrocket-mode="${siteConfig.chat.mode}" data-contextrocket-accent="${attr(accent)}" data-contextrocket-background="${attr(widgetColor("--background", "#FAF9F6"))}" data-contextrocket-foreground="${attr(widgetColor("--foreground", "#0E0F13"))}" data-contextrocket-surface="${attr(widgetColor("--card", "#FFFFFF"))}" data-contextrocket-muted="${attr(widgetColor("--muted-foreground", "#5E616B"))}" data-contextrocket-border="${attr(widgetColor("--border", "#E3E0D9"))}" data-contextrocket-fullscreen="${siteConfig.chat.fullscreen}" data-contextrocket-fullscreen-on-open="${siteConfig.chat.fullscreenOnOpen}" data-contextrocket-fullscreen-on-load="${siteConfig.chat.fullscreenOnLoad}" data-contextrocket-powered-by-logo="${siteConfig.chrome.poweredByTone}"></script>`
  : "";

const homeJsonLd = includeSiteJsonLd ? buildHomeJsonLd() : [];
const extraJsonLd = (Astro.props.jsonLdExtra ?? []).filter(
  (node): node is JsonLdNode =>
    Boolean(node) && typeof node === "object" && !Array.isArray(node),
);
const jsonLd = [...homeJsonLd, ...extraJsonLd];
const jsonLdPayload = jsonLd.length > 0 ? jsonLd : null;
---

<!doctype html>
<html lang={locale} translate="no" class="notranslate">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={siteConfig.companyName} />
    <meta name="author" content={siteConfig.companyName} />
    <meta name="robots" content={robots} />
    {
      siteConfig.verification?.google && (
        <meta
          name="google-site-verification"
          content={siteConfig.verification.google}
        />
      )
    }
    {themeColor && <meta name="theme-color" content={themeColor} />}
    <link rel="canonical" href={canonical} />
    {
      multiLocale &&
        hreflangLocales.map((l) => (
          <link rel="alternate" hreflang={l} href={hreflangHref(l)} />
        ))
    }
    {
      multiLocale && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={hreflangHref(defaultHreflangLocale)}
        />
      )
    }
    <link
      rel="icon"
      {...(String(siteConfig.assets.faviconIco || "").endsWith(".svg")
        ? { type: "image/svg+xml" }
        : {})}
      href={siteConfig.assets.faviconIco ?? "/favicon.ico"}
    />
    {
      siteConfig.assets.icon16 && (
        <link
          rel="icon"
          type="image/png"
          sizes="16x16"
          href={siteConfig.assets.icon16}
        />
      )
    }
    {
      siteConfig.assets.icon32 && (
        <link
          rel="icon"
          type="image/png"
          sizes="32x32"
          href={siteConfig.assets.icon32}
        />
      )
    }
    {
      siteConfig.assets.icon192 && (
        <link
          rel="icon"
          type="image/png"
          sizes="192x192"
          href={siteConfig.assets.icon192}
        />
      )
    }
    {
      siteConfig.assets.icon512 && (
        <link
          rel="icon"
          type="image/png"
          sizes="512x512"
          href={siteConfig.assets.icon512}
        />
      )
    }
    {
      siteConfig.assets.appleTouchIcon && (
        <link rel="apple-touch-icon" href={siteConfig.assets.appleTouchIcon} />
      )
    }
    <link rel="manifest" href="/manifest.webmanifest" />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.companyName} />
    <meta property="og:title" content={pageTitle || siteConfig.homeTitle || siteConfig.companyName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={ogImage} />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle || siteConfig.homeTitle || siteConfig.companyName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}

    {
      siteConfig.features.blog && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title="RSS"
          href={absoluteUrl(siteConfig.blog.feedPath)}
        />
      )
    }
    {
      jsonLdPayload && (
        <script
          type="application/ld+json"
          is:inline
          set:html={serializeJsonLd(jsonLdPayload)}
        />
      )
    }
    {preloadInterTight && (
      <link
        rel="preload"
        href={interTightFont}
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <style is:inline set:html={fontFaceCss}></style>
    <style is:inline>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }
    </style>
    <style set:html={themeCss}></style>
    {widgetSnippet && <Fragment set:html={widgetSnippet} />}
  </head>
  <body
    class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased"
  >
    <SiteChrome locale={locale} path={path}>
      <div class="flex-1">
        <slot />
      </div>
    </SiteChrome>
    <SiteIntegrations />
    <CookieBanner locale={locale} />
  </body>
</html>
