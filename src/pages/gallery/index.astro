---
import GalleryPage from "@/components/pages/GalleryPage.astro";
import { isSingleLocale, siteConfig } from "@/config/site.config";
import { getDefaultLocale } from "@/i18n/locales";
import { soleLocale } from "@/lib/routing";

if (!siteConfig.features.gallery) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
if (!isSingleLocale()) {
  return Astro.redirect(`/${getDefaultLocale()}/gallery/`);
}
const locale = soleLocale();
---

<GalleryPage locale={locale} />
