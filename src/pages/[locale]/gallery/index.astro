---
import GalleryPage from "@/components/pages/GalleryPage.astro";
import { siteConfig } from "@/config/site.config";
import { getActiveLocales, type SupportedLocale } from "@/i18n/locales";

export function getStaticPaths() {
  if (!siteConfig.features.gallery) return [];
  return getActiveLocales().map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as SupportedLocale;
---

<GalleryPage locale={locale} />
