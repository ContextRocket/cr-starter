---
/**
 * Global 404 — branded not-found surface.
 * Uses default locale + BaseLayout (SiteChrome + CookieBanner).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site.config";
import { getDefaultLocale } from "@/i18n/locales";
import { createT } from "@/i18n/keys";
import { homeHref } from "@/lib/paths";

const locale = getDefaultLocale();
const t = createT(locale);
const title = t("error.notFound.title");
const description = t("error.notFound.description");
const action = t("error.notFound.action");
const home = homeHref(locale);
const brand = siteConfig.companyName;
---

<BaseLayout locale={locale} title={title} description={description} path="/404">
  <main
    class="flex flex-1 flex-col items-center justify-center px-6 py-24 text-center"
    data-testid="not-found-page"
  >
    <p class="text-sm font-medium uppercase tracking-wide text-muted-foreground">
      {brand}
    </p>
    <h1 class="mt-3 text-3xl font-bold text-foreground md:text-4xl">{title}</h1>
    <p class="mx-auto mt-4 max-w-md text-lg text-muted-foreground">{description}</p>
    <a
      href={home}
      class="mt-8 inline-flex text-sm font-medium text-primary underline-offset-4 hover:underline"
    >
      {action}
    </a>
  </main>
</BaseLayout>
