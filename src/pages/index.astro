---
import { getDefaultLocale } from "@/i18n/locales";
import { siteConfig } from "@/config/site.config";
import StarterHome from "@/components/pages/StarterHome.astro";
import { redirectTargetForUnprefixedRoute } from "@/lib/routing";

const redirectTarget = redirectTargetForUnprefixedRoute(
  "/",
  new URL(Astro.request.url).search,
);
const locale = getDefaultLocale();
---

{redirectTarget ? (
  <html lang={locale}>
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex, follow" />
      <meta http-equiv="refresh" content={`0;url=${redirectTarget}`} />
      <title>{siteConfig.companyName}</title>
      <script is:inline define:vars={{ redirectTarget }}>
        window.location.replace(redirectTarget);
      </script>
    </head>
    <body></body>
  </html>
) : (
  <StarterHome locale={locale} />
)}
