---
import { getDefaultLocale } from "@/i18n/locales";
import StarterHome from "@/components/pages/StarterHome.astro";
import { redirectTargetForUnprefixedRoute } from "@/lib/routing";

const redirectTarget = redirectTargetForUnprefixedRoute(
  "/",
  new URL(Astro.request.url).search,
);
if (redirectTarget) return Astro.redirect(redirectTarget);
const locale = getDefaultLocale();
---

<StarterHome locale={locale} />
