---
import { getActiveLocales, getDefaultLocale, type SupportedLocale } from "@/i18n/locales";
import { createT } from "@/i18n/keys";
import { siteConfig } from "@/config/site.config";
import StarterHome from "@/components/pages/StarterHome.astro";

const defaultLocale = getDefaultLocale();
const activeLocales = getActiveLocales();
const localeLabelKeys: Record<SupportedLocale, "locale.labelEnglish" | "locale.labelSpanish" | "locale.labelGerman"> = {
  en: "locale.labelEnglish",
  es: "locale.labelSpanish",
  de: "locale.labelGerman",
};
const localeCopy = Object.fromEntries(activeLocales.map((locale) => {
  const t = createT(locale);
  return [locale, {
    title: t("locale.redirectTitle"),
    body: t("locale.redirectBody"),
    status: t("locale.redirectStatus"),
    choose: t("locale.redirectChoose"),
    labels: Object.fromEntries(activeLocales.map((code) => [code, t(localeLabelKeys[code])])),
  }];
}));
const copy = localeCopy[defaultLocale];
const singleLocale = activeLocales.length === 1;
---

{singleLocale ? (
  <StarterHome locale={defaultLocale} />
) : (
  <html lang={defaultLocale}>
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex, follow" />
      <meta name="theme-color" content="#FAF9F6" />
      <title>{siteConfig.companyName}</title>
      <style is:global>
        :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
        * { box-sizing: border-box; }
        body { margin: 0; min-width: 320px; min-height: 100vh; background: #FAF9F6; color: #0E0F13; }
        .locale-handoff-header { height: 4.5rem; border-bottom: 1px solid #E5E1D9; background: #FFFFFF; }
        .locale-handoff-nav { display: flex; width: min(100% - 2rem, 80rem); height: 100%; margin: 0 auto; align-items: center; }
        .locale-handoff-logo { display: block; width: 180px; height: 24px; object-fit: contain; }
        .locale-handoff-main { display: grid; min-height: calc(100vh - 4.5rem); place-items: center; padding: 2rem 1.25rem 4rem; }
        .locale-handoff-card { width: min(100%, 30rem); text-align: center; }
        .locale-handoff-spinner { width: 2.25rem; height: 2.25rem; margin: 0 auto 1.5rem; border: 2px solid #E5E1D9; border-top-color: #0E0F13; border-radius: 50%; animation: locale-spin .8s linear infinite; }
        .locale-handoff-title { margin: 0; font-size: clamp(1.7rem, 5vw, 2.25rem); line-height: 1.1; letter-spacing: -.04em; }
        .locale-handoff-body { margin: 1rem auto 0; max-width: 27rem; color: #5E616B; font-size: 1rem; line-height: 1.65; }
        .locale-handoff-status { margin: 1rem 0 0; color: #5E616B; font-size: .875rem; }
        .locale-handoff-options { display: flex; flex-wrap: wrap; justify-content: center; gap: .625rem; margin-top: 2rem; }
        .locale-handoff-option { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; border: 1px solid #D9D5CE; border-radius: 999px; padding: .625rem 1rem; color: #0E0F13; font-size: .875rem; font-weight: 600; text-decoration: none; transition: background-color .15s ease, border-color .15s ease; }
        .locale-handoff-option:hover { border-color: #0E0F13; background: #F0EEE9; }
        .locale-handoff-option:focus-visible { outline: 2px solid #0E0F13; outline-offset: 3px; }
        @keyframes locale-spin { to { transform: rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) { .locale-handoff-spinner { animation-duration: 2.4s; } }
      </style>
    </head>
    <body>
      <header class="locale-handoff-header">
        <nav class="locale-handoff-nav" aria-label={copy.choose}>
          <a href={`/${defaultLocale}/`} aria-label={siteConfig.companyName}>
            <img class="locale-handoff-logo" src={siteConfig.assets.wordmark} alt={siteConfig.companyName} width="180" height="24" />
          </a>
        </nav>
      </header>
      <main class="locale-handoff-main">
        <section class="locale-handoff-card" aria-labelledby="locale-handoff-title">
          <div class="locale-handoff-spinner" aria-hidden="true"></div>
          <h1 class="locale-handoff-title" id="locale-handoff-title">{copy.title}</h1>
          <p class="locale-handoff-body" id="locale-handoff-body">{copy.body}</p>
          <p class="locale-handoff-status" id="locale-handoff-status" role="status" aria-live="polite">{copy.status}</p>
          <nav class="locale-handoff-options" aria-label={copy.choose}>
            {activeLocales.map((code) => (
              <a class="locale-handoff-option" href={`/${code}/`} data-locale-option={code}>
                {copy.labels[code]}
              </a>
            ))}
          </nav>
        </section>
      </main>
      <script is:inline define:vars={{ defaultLocale, activeLocales, localeCopy }}>
        const supported = activeLocales;
        const browserLanguages = [
          ...(Array.isArray(navigator.languages) ? navigator.languages : []),
          navigator.language,
        ].filter(Boolean);
        const preferredLocale = browserLanguages
          .map((language) => language.toLowerCase().split("-")[0])
          .find((language) => supported.includes(language)) || defaultLocale;
        const localizedCopy = localeCopy[preferredLocale] || localeCopy[defaultLocale];
        document.documentElement.lang = preferredLocale;
        document.getElementById("locale-handoff-title").textContent = localizedCopy.title;
        document.getElementById("locale-handoff-body").textContent = localizedCopy.body;
        document.getElementById("locale-handoff-status").textContent = localizedCopy.status;
        document.querySelectorAll("[data-locale-option]").forEach((link) => {
          const code = link.getAttribute("data-locale-option");
          link.textContent = localizedCopy.labels[code] || link.textContent;
          link.href = `/${code}/${window.location.search}${window.location.hash}`;
        });
        if (preferredLocale !== defaultLocale) {
          const logoLink = document.querySelector(".locale-handoff-nav a");
          logoLink.href = `/${preferredLocale}/${window.location.search}${window.location.hash}`;
        }
        const delay = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 250 : 450;
        window.setTimeout(() => {
          window.location.replace(`/${preferredLocale}/${window.location.search}${window.location.hash}`);
        }, delay);
      </script>
    </body>
  </html>
)}
