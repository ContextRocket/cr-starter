{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["astro/client", "node"]
  },
  "include": ["src/**/*", "config/**/*", "blog.config.mjs", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules", "scratchpad", "cli", "clients"]
}
