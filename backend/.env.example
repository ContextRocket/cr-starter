# backend/.env.example -- copy to backend/.env and adjust.
#
# Ports use the template-specific values (5452/5453/1026/8100) to avoid
# colliding with the sibling context-rocket project (5442/5443/1025/8000).
# The Makefile exports BACKEND_PORT=8100 and DB_PORT=5452 so these values
# are consistent across all entry points.

# Local database (port 5452, isolated from context-rocket which uses 5442)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5452/app_db

# Test database (port 5453, isolated from context-rocket which uses 5443)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5453/app_test_db

# Connection pooling strategy (default: "null")
# "null" - No pooling, new connection per request (best for serverless: Vercel, Lambda)
# "queue" - Connection pool with reuse (best for traditional servers: Docker, VPS, Kubernetes)
# DATABASE_POOL_CLASS=null
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_RECYCLE=3600

# Secret keys -- CHANGE these in production (must be at least 32 chars)
ACCESS_SECRET_KEY=dev-access-secret-CHANGE-IN-PRODUCTION-min-32-chars
RESET_PASSWORD_SECRET_KEY=dev-reset-secret-CHANGE-IN-PRODUCTION-min-32-chars
VERIFICATION_SECRET_KEY=dev-verify-secret-CHANGE-IN-PRODUCTION-min-32-chars

# OpenAPI generated file output path (relative to backend directory)
# IMPORTANT: Frontend must use the same path (relative to frontend directory)
# Both point to the same file: <project-root>/local-shared-data/openapi.json
OPENAPI_OUTPUT_FILE=../local-shared-data/openapi.json

# Localhost Email configuration (MailHog on port 1026, isolated from context-rocket which uses 1025)
MAIL_SERVER=localhost
MAIL_PORT=1026
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME=ContextRocket Starter
# MAIL_USERNAME and MAIL_PASSWORD are optional for MailHog local dev
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Frontend URL (port 3100, isolated from context-rocket which uses 3000)
FRONTEND_URL=http://localhost:3100

# Backend base URL (port 8100, isolated from context-rocket which uses 8000)
# BACKEND_URL=http://localhost:8100

# CORS -- restrict to the frontend origin for local development.
# Never use ["*"] with credentials: wildcard CORS with cookies or Authorization
# headers is forbidden by the Fetch spec and all major browsers will reject it.
CORS_ORIGINS=["http://localhost:3100"]

# Webhook header names (override to brand your webhook headers)
# WEBHOOK_HEADER_APP_ID=X-App-Id
# WEBHOOK_HEADER_THREAD_ID=X-Thread-Id

# OPENAPI (Uncomment the line below to disable the /docs and openapi.json urls)
# OPENAPI_URL=""
